#!/bin/bash
# Pre-push hook: scan every unpublished commit for secrets/PII before pushing.
# Vereist: git config core.hooksPath .githooks (eenmalig per developer)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PATTERN_FILE="$SCRIPT_DIR/sensitive-patterns.txt"
REMOTE_NAME="$1"

KNOWN_SYNTHETIC_VALUES='wegwerpwachtwoord-niet-geheim|(password|pwd)[[:space:]]*=[[:space:]]*\$|=[[:space:]]*(password\b|userInfo\.|wachtwoord\b|devonly\b|devonly123!|YOUR_[A-Z_]*PASSWORD\b|\[password\]|_{4,})|900012345'

check_pattern_config() {
  if [ ! -f "$PATTERN_FILE" ]; then
    echo "BLOCKED: required local sensitive-pattern configuration is missing." >&2
    echo "Copy the approved local template, configure it, and retry." >&2
    return 1
  fi
  active_patterns=0
  while IFS= read -r configured_pattern || [ -n "$configured_pattern" ]; do
    [[ "$configured_pattern" =~ ^[[:space:]]*$ ]] && continue
    [[ "$configured_pattern" =~ ^[[:space:]]*# ]] && continue
    active_patterns=$((active_patterns + 1))
    printf '' | grep -E -q -e "$configured_pattern" >/dev/null 2>&1
    grep_status=$?
    if [ "$grep_status" -gt 1 ]; then
      echo "BLOCKED: local sensitive-pattern configuration contains an invalid rule." >&2
      return 1
    fi
  done < "$PATTERN_FILE"
  if [ "$active_patterns" -eq 0 ]; then
    echo "BLOCKED: local sensitive-pattern configuration has no active rules." >&2
    return 1
  fi
  return 0
}

if [ -z "$REMOTE_NAME" ]; then
  echo "BLOCKED: Git did not provide a remote name to the push hook." >&2
  exit 1
fi
if ! check_pattern_config; then
  exit 1
fi

echo "Scanning repository before push."
FOUND_ISSUE=0

# ── 1. Blokkeer data-bestanden in working tree ────────────────────────────────
BLOCKED_EXT_PATTERN="\.(csv|xlsx|xls|xlsm|mdb|accdb)$"
TRACKED_DATA_FILES=$(git ls-files | grep -iE "$BLOCKED_EXT_PATTERN" || true)
if [ -n "$TRACKED_DATA_FILES" ]; then
  echo "BLOCKED: tracked data files may contain personal data."
  while IFS= read -r f; do [ -z "$f" ] || echo "  File: $f"; done <<< "$TRACKED_DATA_FILES"
  FOUND_ISSUE=1
fi

# ── 2. Scan alle commits in het pushbereik ─────────────────────────────────────
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # Een nieuwe remote-branch heeft geen remote tip. Scan alle commits die nog niet via
    # remote-tracking refs zijn gepubliceerd, niet alleen de branchtip.
    RANGE_SPEC="$local_sha --not --remotes=$REMOTE_NAME"
    if ! COMMITS=$(git rev-list --reverse "$local_sha" --not --remotes="$REMOTE_NAME" 2>/dev/null); then
      echo "BLOCKED: could not determine the complete new-branch push range."
      FOUND_ISSUE=1
      continue
    fi
  else
    RANGE_SPEC="$remote_sha..$local_sha"
    if ! COMMITS=$(git rev-list --reverse "$RANGE_SPEC" 2>/dev/null); then
      echo "BLOCKED: could not determine the complete existing-branch push range."
      FOUND_ISSUE=1
      continue
    fi
  fi

  if [ -z "$COMMITS" ]; then
    echo "No unpublished commits in this push range."
    continue
  fi

  while IFS= read -r commit; do
    [ -z "$commit" ] && continue
    CHANGED_FILES=$(git diff-tree --root --no-commit-id --name-only -r -m "$commit" 2>/dev/null)
    if [ $? -ne 0 ]; then
      echo "BLOCKED: could not list changed files for a commit in the push range."
      FOUND_ISSUE=1
      continue
    fi

    while IFS= read -r file; do
      [ -z "$file" ] && continue
      if echo "$file" | grep -qiE "$BLOCKED_EXT_PATTERN"; then
        echo "BLOCKED: data file in commit being pushed."
        echo "  File: $file"
        FOUND_ISSUE=1
      fi
    done <<< "$CHANGED_FILES"

    FILES_TO_SCAN=()
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      case "$file" in
        *sensitive-patterns.template.txt|*.gitleaks.toml|*pre-commit|*pre-push|*security-scan.yml) continue ;;
      esac
      FILES_TO_SCAN+=("$file")
    done <<< "$CHANGED_FILES"

    if [ ${#FILES_TO_SCAN[@]} -gt 0 ]; then
      while IFS= read -r pattern || [ -n "$pattern" ]; do
        [[ "$pattern" =~ ^[[:space:]]*$ ]] && continue
        [[ "$pattern" =~ ^[[:space:]]*# ]] && continue
        CANDIDATE_HITS=$(git grep -l -I -i -E -e "$pattern" "$commit" -- "${FILES_TO_SCAN[@]}" 2>/dev/null)
        GREP_STATUS=$?
        if [ "$GREP_STATUS" -gt 1 ]; then
          echo "BLOCKED: the configured pattern scan could not complete."
          FOUND_ISSUE=1
          continue
        fi
        HITS=""
        while IFS= read -r candidate; do
          [ -z "$candidate" ] && continue
          candidate_path="${candidate#*:}"
          REAL_LINES=$(git grep -h -I -i -E -e "$pattern" "$commit" -- "$candidate_path" 2>/dev/null | grep -viE "$KNOWN_SYNTHETIC_VALUES" || true)
          if [ -n "$REAL_LINES" ]; then
            HITS="$HITS
$candidate"
          fi
        done <<< "$CANDIDATE_HITS"
        if [ -n "$HITS" ]; then
          echo "BLOCKED: configured sensitive-data pattern matched a commit in the push range."
          while IFS= read -r hit; do
            [ -z "$hit" ] && continue
            echo "  File: ${hit#*:}"
          done <<< "$HITS"
          FOUND_ISSUE=1
        fi
      done < "$PATTERN_FILE"
    fi
  done <<< "$COMMITS"

  # Gitleaks is optional. When installed, scan the same complete commit set and redact output.
  if command -v gitleaks &>/dev/null; then
    GITLEAKS_REPORT=$(mktemp)
    gitleaks detect --exit-code 1 --no-banner --redact --log-opts="$RANGE_SPEC" -f json -r "$GITLEAKS_REPORT" >/dev/null 2>&1
    GITLEAKS_EXIT=$?
    if [ "$GITLEAKS_EXIT" -ne 0 ]; then
      echo "BLOCKED: gitleaks detected a secret in commits being pushed."
      grep -E '"(RuleID|File|Commit)":' "$GITLEAKS_REPORT" 2>/dev/null
      FOUND_ISSUE=1
    fi
    rm -f "$GITLEAKS_REPORT"
  else
    echo "WAARSCHUWING: gitleaks is niet geinstalleerd — alleen de patroonscan is uitgevoerd."
  fi
done

if [ "$FOUND_ISSUE" -eq 1 ]; then
  echo "PUSH BLOCKED — resolve the scan result and retry."
  exit 1
fi

echo "OK: No secrets or personal data detected. Push allowed."
exit 0
