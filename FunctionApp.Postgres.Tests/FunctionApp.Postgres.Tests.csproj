<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- Microsoft.Extensions.Logging.Abstractions (NullLogger) komt transitief mee via
         FunctionApp.Postgres; een eigen versie hier geeft NU1605 zodra die keten opschuift. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FunctionApp.Postgres\FunctionApp.Postgres.csproj" />
  </ItemGroup>

  <!--
    GEDEELDE TESTBRONNEN — bewust als <Compile Link>, NIET als ProjectReference (issue 890).

    Deze drie bestanden bestaan al elders en zouden anders gedupliceerd moeten worden. Een
    ProjectReference naar het project waar ze staan is hier geen optie:

      * FunctionApp.Tests sleept transitief FunctionApp (de SQL SERVER-tier) mee. Dat is precies de
        cross-tree-koppeling die docs/ARCHITECTUUR-DATABASE-TIERS.md §2 verbiedt — en het zou de
        twee testassemblies bovendien elkaars tests laten ontdekken.
      * Database.Postgres.Tests is zelf een testproject; ernaar verwijzen levert dezelfde
        dubbele-ontdekking op.

    Link-compileren geeft één bronbestand met twee compilaties: wijzigt de fixture, dan wijzigt hij
    voor beide tiers tegelijk — geen kopie die kan driften. De naamruimtes blijven bewust die van
    hun oorspronkelijke project (FunctionApp.Tests.Sync / Database.Postgres.Tests), zodat de
    bestanden zelf ongewijzigd blijven en zichtbaar is waar ze thuishoren.
  -->
  <ItemGroup>
    <!-- #867: tier-onafhankelijke Sportlink-fixtureserver (alleen System.Net) + de opgenomen
         API-antwoorden. Al hergebruikt voor de wegwerp-verificatie van #890 deel 1; nu blijvend. -->
    <Compile Include="..\FunctionApp.Tests\Sync\SportlinkFixtureServer.cs"
             Link="Shared\SportlinkFixtureServer.cs" />
    <Compile Include="..\FunctionApp.Tests\Sync\SportlinkFixtures.cs"
             Link="Shared\SportlinkFixtures.cs" />
    <!-- #866: env-gestuurde [PostgresFact]/[PostgresTheory] — dezelfde variabelenaam en dezelfde
         skip-reden als Database.Postgres.Tests, zodat één CI-variabele beide suites aanzet. -->
    <Compile Include="..\Database.Postgres.Tests\PostgresIntegrationTestAttributes.cs"
             Link="Shared\PostgresIntegrationTestAttributes.cs" />
  </ItemGroup>

</Project>
