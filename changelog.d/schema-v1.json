{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changelog-fragment-v1",
  "title": "Changelogfragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "issues",
    "category",
    "text",
    "release_impact",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "category": { "enum": ["Added", "Changed", "Fixed", "Security", "Removed"] },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^<>`\\[\\]*_~|\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "release_impact": { "enum": ["user_facing", "internal"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_release"],
      "properties": {
        "origin_release": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" }] }
      }
    }
  }
}
