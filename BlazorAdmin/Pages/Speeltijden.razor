@page "/instellingen/speeltijden"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Models
@using BlazorAdmin.Services

<PageTitle>Speeltijden — Admin</PageTitle>

<h1>Speeltijden</h1>
<p class="text-muted">
    <strong>WedstrijdTotaal</strong> = speeltijd + rust (inclusief buffer). Dit is de totale veldblokkeertijd.
    De planner gebruikt dit getal direct — rust wordt <em>niet</em> apart opgeteld in de code.
</p>

@if (_loading)
{
    <p>Laden...</p>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="text-end mb-2">
        <button class="btn btn-success" @onclick="StartNew">Nieuwe categorie</button>
    </div>

    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Leeftijd</th>
                <th>Veldafmeting</th>
                <th title="speeltijd + rust incl. buffer">Totaal (min) <small class="text-muted">incl. rust</small></th>
                <th>Helft (min)</th>
                <th>Rust (min)</th>
                <th title="Gebruikt als een team geen eigen voorkeurstijd heeft">Standaard voorkeurstijd</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_editing != null && _isNew)
            {
                <tr class="speeltijd-formulierrij">
                    <td colspan="7">
                        <SpeeltijdFormulier Model="_editing" IsNew="true" SaveError="@_saveError"
                                            OnOpslaan="OpslaanAsync" OnAnnuleer="Annuleer" />
                    </td>
                </tr>
            }
            @foreach (var s in _items)
            {
                var inBewerking = IsInBewerking(s);
                <tr class="@(inBewerking ? "table-active" : null)">
                    <td>@s.Leeftijd</td>
                    <td>@s.Veldafmeting.ToString("0.00")</td>
                    <td><strong>@s.WedstrijdTotaal</strong></td>
                    <td>@s.WedstrijdHelft</td>
                    <td>@s.WedstrijdRust</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(s.StandaardVoorkeurTijd))
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @s.StandaardVoorkeurTijd
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => Edit(s)">Bewerken</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(s.Leeftijd)">Verwijderen</button>
                    </td>
                </tr>
                @if (inBewerking)
                {
                    <tr class="speeltijd-formulierrij">
                        <td colspan="7">
                            <SpeeltijdFormulier Model="_editing!" IsNew="false" SaveError="@_saveError"
                                                OnOpslaan="OpslaanAsync" OnAnnuleer="Annuleer" />
                        </td>
                    </tr>
                }
            }
            @if (_items.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">Geen speeltijden gevonden.</td></tr>
            }
        </tbody>
    </table>
}
