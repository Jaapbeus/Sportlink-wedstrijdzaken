@page "/instellingen/speeltijden"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Models
@using BlazorAdmin.Services

<PageTitle>Speeltijden — Admin</PageTitle>

<h1>Speeltijden</h1>
<p class="text-muted">
    <strong>WedstrijdTotaal</strong> = speeltijd + rust (inclusief buffer). Dit is de totale veldblokkeertijd.
    De planner gebruikt dit getal direct — rust wordt <em>niet</em> apart opgeteld in de code.
</p>

@if (_loading)
{
    <p>Laden...</p>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="text-end mb-2">
        <button class="btn btn-success" @onclick="StartNew">Nieuwe categorie</button>
    </div>

    @if (_bewerking.Melding != null)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-start gap-2" role="alert">
            <span>@_bewerking.Melding</span>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="_bewerking.SluitMelding">Sluiten</button>
        </div>
    }
    @if (_bewerking.VerversFout != null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-start gap-2" role="alert">
            <span>@_bewerking.VerversFout</span>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="_bewerking.SluitVerversFout">Sluiten</button>
        </div>
    }

    @* Op een smalle container worden de regels kaarten (Speeltijden.razor.css), zodat het inline
       formulier de beschikbare breedte krijgt in plaats van die van de zevenkolomstabel (#1553).
       De tabelrollen staan expliciet: zodra de cellen display:block krijgen, laat de browser de
       impliciete tabelsemantiek vallen en zou een schermlezer losse tekst horen. *@
    <div class="speeltijden-lijst">
        <table class="table table-striped table-sm speeltijden-tabel" role="table">
            <thead role="rowgroup">
                <tr role="row">
                    <th role="columnheader" scope="col">Leeftijd</th>
                    <th role="columnheader" scope="col">Veldafmeting</th>
                    <th role="columnheader" scope="col" title="speeltijd + rust incl. buffer">Totaal (min) <small class="text-muted">incl. rust</small></th>
                    <th role="columnheader" scope="col">Helft (min)</th>
                    <th role="columnheader" scope="col">Rust (min)</th>
                    <th role="columnheader" scope="col" title="Gebruikt als een team geen eigen voorkeurstijd heeft">Standaard voorkeurstijd</th>
                    <th role="columnheader" scope="col"><span class="visually-hidden">Acties</span></th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                @if (_bewerking.Actief is { IsNieuw: true } nieuw)
                {
                    <tr role="row" class="speeltijd-formulierrij">
                        <td role="cell" colspan="7">
                            <SpeeltijdFormulier @key="nieuw" Sessie="nieuw" OnOpslaan="OpslaanAsync" OnAnnuleer="Annuleer" />
                        </td>
                    </tr>
                }
                @foreach (var s in _bewerking.Items)
                {
                    var inBewerking = _bewerking.IsInBewerking(s);
                    var opslagBezig = _bewerking.IsOpslagBezig(s);
                    <tr role="row" class="@(inBewerking ? "table-active" : null)">
                        <td role="cell" data-label="Leeftijd" class="speeltijd-leeftijd">@s.Leeftijd</td>
                        <td role="cell" data-label="Veldafmeting">@s.Veldafmeting.ToString("0.00")</td>
                        <td role="cell" data-label="Totaal (min)"><strong>@s.WedstrijdTotaal</strong></td>
                        <td role="cell" data-label="Helft (min)">@s.WedstrijdHelft</td>
                        <td role="cell" data-label="Rust (min)">@s.WedstrijdRust</td>
                        <td role="cell" data-label="Standaard voorkeurstijd">
                            @if (string.IsNullOrWhiteSpace(s.StandaardVoorkeurTijd))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @s.StandaardVoorkeurTijd
                            }
                        </td>
                        <td role="cell" class="speeltijd-acties">
                            @if (opslagBezig)
                            {
                                <span class="text-muted small me-1" role="status">Opslaan…</span>
                            }
                            <button class="btn btn-sm btn-primary me-1" disabled="@opslagBezig" @onclick="() => Edit(s)">Bewerken</button>
                            <button class="btn btn-sm btn-outline-danger" disabled="@opslagBezig" @onclick="() => DeleteAsync(s.Leeftijd)">Verwijderen</button>
                        </td>
                    </tr>
                    @if (inBewerking)
                    {
                        <tr role="row" class="speeltijd-formulierrij">
                            <td role="cell" colspan="7">
                                <SpeeltijdFormulier @key="_bewerking.Actief" Sessie="_bewerking.Actief!" OnOpslaan="OpslaanAsync" OnAnnuleer="Annuleer" />
                            </td>
                        </tr>
                    }
                }
                @if (_bewerking.Items.Count == 0)
                {
                    <tr role="row"><td role="cell" colspan="7" class="text-muted">Geen speeltijden gevonden.</td></tr>
                }
            </tbody>
        </table>
    </div>
}
