@page "/instellingen"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Services

<PageTitle>Instellingen — Beheer</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Instellingen</h1>
    @if (settings != null && string.IsNullOrEmpty(errorMessage))
    {
        <button type="submit" form="settings-form" class="btn btn-primary" disabled="@saving">
            @(saving ? "Opslaan..." : "Opslaan")
        </button>
    }
</div>

@if (!_isTestmodus)
{
    @* ── Synchronisatie (verplaatst van Dashboard #344) ── *@
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Synchronisatie</h5>
                    @if (_syncLoading)
                    {
                        <p class="text-muted">Laden...</p>
                    }
                    else if (_status == null)
                    {
                        <p class="text-danger">Kon synchronisatiestatus niet ophalen.</p>
                    }
                    else
                    {
                        <p>
                            <strong>Laatste sync:</strong>
                            @(_status.LastSyncTimestamp.HasValue
                                  ? _status.LastSyncTimestamp.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                  : "nog niet uitgevoerd")
                        </p>
                        <p>
                            <strong>Schema:</strong> @CronNaarNederlands(_status.FetchSchedule)
                            <small class="text-muted ms-1">(<code>@_status.FetchSchedule</code>)</small>
                        </p>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(_status.Status == "ok" ? "bg-success" : "bg-warning")">
                                @_status.Status
                            </span>
                        </p>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="TriggerSyncAsync" disabled="@(_syncing)">
                        @(_syncing ? "Synchroniseren..." : "Nu synchroniseren")
                    </button>
                    @if (!string.IsNullOrEmpty(_syncResult))
                    {
                        <div class="alert alert-info mt-3">@_syncResult</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Email verwerking (laatste 24u)</h5>
                    @if (_emailLog == null && !_syncLoading)
                    {
                        <p class="text-muted">Niet beschikbaar.</p>
                    }
                    else if (_emailLog != null)
                    {
                        <p><strong>Antwoord verstuurd:</strong> @_emailVerwerkt</p>
                        <p>
                            <strong>Handmatige planning:</strong> @_emailGeenAntwoord
                            <span class="text-muted small d-block">Planning is mogelijk — bewust geen automatisch antwoord verstuurd</span>
                        </p>
                        <p><strong>Fouten:</strong> @_emailFouten</p>
                        <p><strong>Buiten scope:</strong> @_emailBuitenScope</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <hr class="mb-4" />
}

@if (_isTestmodus)
{
    <div class="alert alert-info">
        <i class="bi bi-database-gear me-2"></i>
        <strong>Testmodus actief</strong> — Instellingen, synchronisatie en e-mailverwerking zijn niet beschikbaar voor ALLSTARS testdata.
        Gebruik de <strong>Testmodus — verlaten</strong>-knop in de zijbalk om terug te schakelen naar de normale clubweergave.
    </div>
}
else if (settings == null && string.IsNullOrEmpty(errorMessage))
{
    <p class="text-muted">Laden...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="settings" OnValidSubmit="OpslaanAsync" id="settings-form">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Clubnaam</label>
                <input class="form-control" value="@settings!.ClubName" disabled />
                <small class="form-text text-muted">
                    Staat in AI-systeem-prompt en e-mailtemplates. Contacteer de systeembeheerder om deze waarde te wijzigen.
                </small>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">ClubCode</label>
                <input class="form-control" value="@settings.ClubCode" disabled />
                <small class="form-text text-muted">
                    Unieke identifier voor multi-club ondersteuning — staat als filter in elke database-query. Contacteer de systeembeheerder om deze waarde te wijzigen.
                </small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Accommodatie</label>
                <input class="form-control" @bind="settings.Accommodatie" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Accommodatieplaats</label>
                <div class="input-group">
                    <input class="form-control" @bind="settings.AccommodatiePlaats" placeholder="bijv. uw plaatsnaam" />
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="ZoekCoordinaten" disabled="@(geocoding || string.IsNullOrWhiteSpace(settings.AccommodatiePlaats))">
                        @(geocoding ? "Zoeken..." : "Zoek coördinaten")
                    </button>
                </div>
                @if (settings.AccommodatieLatitude.HasValue && settings.AccommodatieLongitude.HasValue)
                {
                    <small class="form-text text-muted">
                        Coördinaten: @settings.AccommodatieLatitude.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture), @settings.AccommodatieLongitude.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)
                    </small>
                }
                @if (!string.IsNullOrEmpty(geocodeMessage))
                {
                    <small class="form-text @(geocodeError ? "text-danger" : "text-success")">@geocodeMessage</small>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Herplan-deadline (dagen vooraf)</label>
                <input class="form-control" type="number" min="0" max="60" @bind="settings.HerplanDeadlineDagen" />
                <small class="form-text text-muted">
                    Herplanverzoeken die binnenkomen minder dan dit aantal dagen vóór de wedstrijd worden
                    afgewezen door de planner. Standaard: 8 dagen.
                </small>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Buffer tussen wedstrijden (minuten)</label>
                <input class="form-control" type="number" min="0" max="120" @bind="settings.BufferMinuten" />
                <small class="form-text text-muted">
                    Minimale pauze tussen twee wedstrijden op hetzelfde veld bij het zoeken naar
                    een nieuwe speeltijd. Standaard: 15 minuten.
                </small>
            </div>
        </div>

        <hr />
        <h5>Afzender &amp; coördinator</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Planner afzendernaam</label>
                <input class="form-control" @bind="settings.PlannerAfzenderNaam" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Planner e-mailadres</label>
                <input class="form-control" @bind="settings.PlannerEmailAdres" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Coördinator naam</label>
                <input class="form-control" @bind="settings.CoordinatorNaam" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Coördinator functie</label>
                <input class="form-control" @bind="settings.CoordinatorFunctie" />
            </div>
        </div>

        <hr />
        <h5>Synchronisatie</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">FetchSchedule (CRON)</label>
                <input class="form-control" @bind="settings.FetchSchedule" />
                @if (!string.IsNullOrEmpty(settings.FetchScheduleLeesbaar))
                {
                    <small class="form-text text-muted">@settings.FetchScheduleLeesbaar</small>
                }
                @if (settings.VolgendeMomenten?.Count > 0)
                {
                    <small class="form-text text-muted">
                        Volgende uitvoeringen (UTC): @string.Join(", ", settings.VolgendeMomenten)
                    </small>
                }
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Laatste synchronisatie</label>
                <input class="form-control" value="@(settings.LastSyncTimestamp?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "nog niet uitgevoerd")" disabled />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="useRealtimeApi"
                           @bind="settings.UseRealtimeApi" />
                    <label class="form-check-label" for="useRealtimeApi">
                        Real-time Sportlink API raadplegen
                    </label>
                </div>
                <small class="form-text text-muted">
                    Aan: de planner checkt beschikbaarheid direct bij de Sportlink API (meest actueel).
                    Uit: alleen de lokale database wordt gebruikt (sneller, werkt zonder API-verbinding).
                </small>
            </div>
        </div>

        <hr />
        <h5>KNVB-verzetten zonder datum</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="knvbPdfBijlageIngeschakeld"
                           @bind="settings.KnvbPdfBijlageIngeschakeld" />
                    <label class="form-check-label" for="knvbPdfBijlageIngeschakeld">
                        KNVB-kalender bij verzet-verzoek van tegenstander
                    </label>
                </div>
                <small class="form-text text-muted">
                    Aan: als een tegenstander om een herplanning vraagt zonder concrete nieuwe datum te noemen,
                    stuurt de pipeline automatisch een antwoord met een paar vrije zaterdagen en de
                    KNVB-speeldagenkalender als PDF-bijlage (met de begeleiding van het eigen team in BCC).
                    Staat standaard AAN.
                </small>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">KNVB-regio</label>
                <select class="form-select" @bind="settings.KnvbStandaardRegio">
                    <option value="">(niet ingesteld)</option>
                    <option value="West">West</option>
                    <option value="Noord">Noord</option>
                    <option value="Oost">Oost</option>
                    <option value="Zuid">Zuid</option>
                    <option value="Landelijk">Landelijk</option>
                    <option value="LandelijkJeugd">LandelijkJeugd</option>
                </select>
                <small class="form-text text-muted">
                    Bepaalt welke KNVB-speeldagenkalender wordt gebruikt bij bovenstaande bijlage.
                    Ontbreekt deze instelling, dan wordt de bijlage/nieuwe flow overgeslagen — er is
                    bewust geen standaardregio in code (elke club stelt de eigen regio hier in).
                </small>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@saving">
            @(saving ? "Opslaan..." : "Opslaan")
        </button>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3">@successMessage</div>
        }
        @if (!string.IsNullOrEmpty(herstartMessage))
        {
            <div class="alert alert-info mt-3">@herstartMessage</div>
        }
    </EditForm>

    <hr class="mt-4" />
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-1">Teambegeleiding importeren</h5>
                <p class="text-muted mb-0">
                    CSV-export uit Sportlink inlezen — vervangt de teambegeleiding van deze club volledig.
                </p>
            </div>
            <a class="btn btn-outline-primary" href="instellingen/teambegeleiding-import">Openen →</a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-1">Sportlink Web Extension</h5>
                <p class="text-muted mb-0">
                    Aan/uit, serviceaccount-koppeling per rol, en status — nu op een eigen pagina met
                    meer ruimte voor uitleg.
                </p>
            </div>
            <a class="btn btn-outline-primary" href="sportlink-extension-settings">Openen →</a>
        </div>
    </div>

    <hr class="mt-4" />
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Uitgesloten e-mailadressen</h2>
            <p class="text-muted mb-0">
                Adressen op deze lijst worden altijd overgeslagen door de email-verwerker.
            </p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNieuwAdres">Adres toevoegen</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>E-mailadres</th>
                <th>Omschrijving</th>
                <th>Actief</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var adres in uitgeslotenEmails)
            {
                <tr class="@(!adres.Actief ? "text-muted" : "")">
                    <td>@adres.EmailAdres</td>
                    <td>@adres.Omschrijving</td>
                    <td>@(adres.Actief ? "ja" : "nee")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => VerwijderAdresAsync(adres.Id)">
                            Verwijderen
                        </button>
                    </td>
                </tr>
            }
            @if (uitgeslotenEmails.Count == 0)
            {
                <tr><td colspan="4" class="text-muted">Geen uitgesloten adressen.</td></tr>
            }
        </tbody>
    </table>

    @if (nieuwAdres != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Nieuw adres toevoegen</h5>
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label class="form-label">E-mailadres</label>
                        <input class="form-control" @bind="nieuwAdres.EmailAdres" placeholder="bijv. wedstrijdsecretaris@jouwclub.nl" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">Omschrijving (optioneel)</label>
                        <input class="form-control" @bind="nieuwAdres.Omschrijving" placeholder="bijv. Wedstrijdsecretaris eigen club" />
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="OpslaanNieuwAdresAsync">Toevoegen</button>
                <button class="btn btn-secondary ms-2" @onclick="() => nieuwAdres = null">Annuleren</button>
                @if (!string.IsNullOrEmpty(uitgeslotenMessage))
                {
                    <div class="alert alert-info mt-2">@uitgeslotenMessage</div>
                }
            </div>
        </div>
    }
}
