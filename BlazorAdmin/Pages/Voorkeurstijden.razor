@page "/voorkeurstijden"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Models
@using BlazorAdmin.Services

<PageTitle>Voorkeurstijden — Beheer</PageTitle>

<h1>Team voorkeurstijden</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Filter op team" @bind="filterTeam" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-success" @onclick="StartNew">Nieuwe voorkeur</button>
    </div>
</div>

@if (loading)
{
    <p>Laden...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Team</th>
                <th>Dag</th>
                <th>Tijd</th>
                <th>Prioriteit</th>
                <th>Actief</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Gefilterd)
            {
                <tr class="@(!v.Actief ? "text-muted" : "")">
                    <td>@v.TeamNaam</td>
                    <td>@DagNamen.Naam(v.DagVanWeek)</td>
                    <td>@v.VoorkeurTijd</td>
                    <td>@v.Prioriteit</td>
                    <td>@(v.Actief ? "ja" : "nee")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => Edit(v)">Bewerken</button>
                        @if (v.Actief)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(v.Id)">
                                Verwijderen
                            </button>
                        }
                    </td>
                </tr>
            }
            @if (Gefilterd.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">Geen voorkeurstijden gevonden.</td></tr>
            }
        </tbody>
    </table>

    @if (editing != null)
    {
        <hr />
        <h3>@(isNew ? "Nieuwe voorkeur" : $"Bewerken: {editing.TeamNaam} #{editing.Id}")</h3>
        <EditForm Model="editing" OnValidSubmit="OpslaanAsync">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Team</label>
                    <select class="form-select" @bind="editing.TeamNaam">
                        <option value="">— Kies een team —</option>
                        @foreach (var t in teams)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Dag</label>
                    <select class="form-select" @bind="editing.DagVanWeek">
                        <option value="1">Maandag</option>
                        <option value="2">Dinsdag</option>
                        <option value="3">Woensdag</option>
                        <option value="4">Donderdag</option>
                        <option value="5">Vrijdag</option>
                        <option value="6">Zaterdag</option>
                        <option value="7">Zondag</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Tijd (HH:mm)</label>
                    <TimeInput Value="@editing.VoorkeurTijd"
                               ValueChanged="@(v => editing.VoorkeurTijd = v ?? string.Empty)"
                               Placeholder="14:30" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Prioriteit</label>
                    <input class="form-control" type="number" min="1" max="10" @bind="editing.Prioriteit" />
                </div>
                <div class="col-md-1 mb-3">
                    <label class="form-label d-block">Actief</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editing.Actief" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary" @onclick="() => editing = null">Annuleren</button>
        </EditForm>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3">@message</div>
    }

    <hr class="mt-4" />
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Teamregels</h2>
            <p class="text-muted mb-0">Buffers vóór/na wedstrijden en veldvoorkeuren per team.</p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNewRegel">Nieuwe regel</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Team</th>
                <th>Regeltype</th>
                <th>Waarde</th>
                <th>Opmerking</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in ActieveTeamRegels)
            {
                <tr>
                    <td>@r.TeamNaam</td>
                    <td>@RegelTypeNederlands(r.RegelType)</td>
                    <td>@RegelWaarde(r)</td>
                    <td>@r.Opmerking</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditRegel(r)">Bewerken</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteRegelAsync(r.Id)">
                            Verwijderen
                        </button>
                    </td>
                </tr>
            }
            @if (ActieveTeamRegels.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">Geen teamregels gevonden.</td></tr>
            }
        </tbody>
    </table>

    @if (editingRegel != null)
    {
        <hr />
        <h3>@(isNewRegel ? "Nieuwe teamregel" : $"Bewerken: {editingRegel.TeamNaam} #{editingRegel.Id}")</h3>
        <EditForm Model="editingRegel" OnValidSubmit="OpslaanRegelAsync">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Team</label>
                    <select class="form-select" @bind="editingRegel.TeamNaam">
                        <option value="">— Kies een team —</option>
                        @foreach (var t in teams)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Regeltype</label>
                    <select class="form-select" @bind="editingRegel.RegelType">
                        <option value="BufferVoor">Buffer vóór wedstrijd (minuten)</option>
                        <option value="BufferNa">Buffer na wedstrijd (minuten)</option>
                        <option value="VoorkeurVeld">Voorkeursveld (veldnummer + optioneel tijd)</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Prioriteit</label>
                    <input class="form-control" type="number" min="0" max="99" @bind="editingRegel.Prioriteit" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label d-block">Actief</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingRegel.Actief" />
                </div>
            </div>

            @if (editingRegel.RegelType == "BufferVoor" || editingRegel.RegelType == "BufferNa")
            {
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Aantal minuten</label>
                        <input class="form-control" type="number" min="0" max="240"
                               value="@editingRegel.WaardeMinuten"
                               @onchange="e => editingRegel.WaardeMinuten = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                    </div>
                </div>
            }

            @if (editingRegel.RegelType == "VoorkeurVeld")
            {
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Veldnummer</label>
                        <input class="form-control" type="number" min="1" max="99"
                               value="@editingRegel.WaardeVeldNummer"
                               @onchange="e => editingRegel.WaardeVeldNummer = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Aanvangstijd (optioneel, HH:mm)</label>
                        <TimeInput @bind-Value="editingRegel.WaardeTijd" Placeholder="bijv. 12:00" />
                        <small class="form-text text-muted">Laat leeg als er geen vaste tijd is</small>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Opmerking (optioneel)</label>
                <input class="form-control" @bind="editingRegel.Opmerking" />
            </div>

            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="() => editingRegel = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(regelMessage))
        {
            <div class="alert alert-info mt-3">@regelMessage</div>
        }
    }
}
