@page "/instellingen/thema"
@using BlazorAdmin.Models
@inherits ClubSelectorPageBase
@* Alle logica staat in Thema.razor.cs (#1270) — regel 3 van docs/ARCHITECTUUR-CODEKWALITEIT.md.
   De injecties en de clubwissel-lifecycle staan daar op de partial class (#1328). *@

<PageTitle>Club-thema — Sportlink Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Club-thema</h1>
        <p class="text-muted mb-0">Pas de huidige kleuren van de beheer-interface aan op de huisstijl van de club.</p>
    </div>
    @if (!_loading && _error == null)
    {
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Opslaan
        </button>
    }
</div>

@if (_loading)
{
    <p><em>Laden...</em></p>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_tab == "instellen" ? "active" : "")" @onclick='() => _tab = "instellen"'>
                Kleuren instellen
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tab == "overzicht" ? "active" : "")" @onclick='() => _tab = "overzicht"'>
                Overzicht
            </button>
        </li>
    </ul>

    @if (_tab == "overzicht")
    {
        @* #1388: leestabel van elke instelbare kleur, gegroepeerd — beantwoordt "welke kleur doet wat"
           zonder dat de beheerder eerst elke picker moet aanklikken. *@
        <div class="card mb-4">
            <div class="card-header">Alle instelbare kleuren</div>
            <div class="card-body">
                <p class="text-muted">
                    Elke rij is een kleur die u hierboven kunt instellen. "Licht" en "Donker" tonen de
                    huidige waarde van beide weergaven, ongeacht welke u op dit moment bewerkt.
                </p>
                @foreach (var groep in ThemePresets.Kleuren.GroupBy(k => k.Groep))
                {
                    <h6 class="fw-semibold mt-3">@groep.Key</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Kleur</th>
                                    <th>Werkingsgebied</th>
                                    <th>CSS-pad</th>
                                    <th>Licht</th>
                                    <th>Donker</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var kleur in groep)
                                {
                                    <tr>
                                        <td class="fw-semibold">@kleur.Label</td>
                                        <td class="text-muted small">@(kleur.Toelichting ?? "—")</td>
                                        <td><ThemaCssPad Kleur="kleur" Selectors="SelectorsVoor(kleur)" Geladen="_cssSelectors != null" /></td>
                                        <td>
                                            <span class="thema-overzicht-swatch" style="--thema-kleur:@KleurUit(_licht, kleur.Sleutel);" aria-hidden="true"></span>
                                            <code class="small">@KleurUit(_licht, kleur.Sleutel)</code>
                                        </td>
                                        <td>
                                            <span class="thema-overzicht-swatch" style="--thema-kleur:@KleurUit(_donker, kleur.Sleutel);" aria-hidden="true"></span>
                                            <code class="small">@KleurUit(_donker, kleur.Sleutel)</code>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">Kleuren instellen</div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Welke weergave bewerkt u?</label>
                        <div class="btn-group" role="group" aria-label="Te bewerken weergave">
                            <button type="button" class="btn @(_modus == "light" ? "btn-primary" : "btn-outline-primary")"
                                    @onclick='() => ModusBewerkenAsync("light")'>
                                <i class="bi bi-sun me-1" aria-hidden="true"></i>Licht bewerken
                            </button>
                            <button type="button" class="btn @(_modus == "dark" ? "btn-primary" : "btn-outline-primary")"
                                    @onclick='() => ModusBewerkenAsync("dark")'>
                                <i class="bi bi-moon-stars me-1" aria-hidden="true"></i>Donker bewerken
                            </button>
                        </div>
                        <small class="d-block text-muted mt-1">
                            De hele beheer-interface schakelt mee, zodat u meteen ziet wat u instelt.
                        </small>
                    </div>

                    @foreach (var groep in ThemePresets.Kleuren.GroupBy(k => k.Groep))
                    {
                        <hr class="my-3" />
                        <h6 class="fw-semibold text-muted">@groep.Key</h6>
                        @foreach (var kleur in groep)
                        {
                            var sleutel = kleur.Sleutel;
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@kleur.Label</label>
                                <div class="d-flex align-items-center gap-2">
                                    @if (kleur.StaatAlphaToe)
                                    {
                                        @* <input type="color"> kent geen alpha en zou de waarde stilzwijgend
                                           terugbrengen tot zes cijfers — daarom hier alleen een tekstveld met
                                           een voorbeeldvlak ernaast. *@
                                        <span class="form-control form-control-color p-0 border thema-kleurvlak"
                                              style="--thema-kleur:@Kleur(sleutel);"
                                              aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <input type="color" class="form-control form-control-color"
                                               value="@Kleur(sleutel)"
                                               @oninput='e => OnColorChange(sleutel, e.Value?.ToString())' />
                                    }
                                    <input type="text" class="form-control" maxlength="9"
                                           value="@Kleur(sleutel)"
                                           @oninput='e => OnColorChange(sleutel, e.Value?.ToString())' />
                                </div>
                                @if (kleur.Toelichting != null)
                                {
                                    <small class="text-muted">@kleur.Toelichting</small>
                                }
                                <ThemaCssPad Kleur="kleur" Selectors="SelectorsVoor(kleur)" Geladen="_cssSelectors != null" />
                            </div>
                        }
                    }

                    <hr class="my-3" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Club-website URL</label>
                        <div class="input-group">
                            <input type="url" class="form-control" placeholder="https://www.mijnclub.nl"
                                   @bind="_theme.ClubWebsiteUrl" @bind:event="oninput" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ExtractFromWebsiteAsync"
                                    disabled="@(_extracting || string.IsNullOrWhiteSpace(_theme.ClubWebsiteUrl))">
                                @if (_extracting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Ophalen
                            </button>
                        </div>
                        @if (_extractError != null)
                        {
                            <div class="alert alert-warning mt-2">@_extractError</div>
                        }
                        @if (_extractedColors.Count > 0)
                        {
                            <div class="mt-2">
                                <p class="small mb-1">Klik op een kleur om deze als primaire kleur van de <strong>@(_modus == "dark" ? "donkere" : "lichte")</strong> weergave in te stellen:</p>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var color in _extractedColors)
                                    {
                                        var capturedColor = color;
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="thema-geextraheerde-kleur" style="--thema-kleur:@capturedColor;"
                                                 title="@capturedColor"
                                                 @onclick='() => OnColorChange("primary", capturedColor)'></div>
                                            <small class="thema-kleur-label">@capturedColor</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Favicon URL</label>
                        <input type="url" class="form-control" placeholder="https://www.mijnclub.nl/favicon.ico"
                               @bind="_theme.FaviconUrl" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(_extractedFaviconUrl))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@_extractedFaviconUrl" alt="Favicon" class="thema-favicon-preview" />
                                <small class="text-muted">Gevonden favicon</small>
                                <button class="btn btn-sm btn-outline-primary" type="button"
                                        @onclick="() => { _theme.FaviconUrl = _extractedFaviconUrl; StateHasChanged(); }">
                                    Gebruiken
                                </button>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Club-logo URL</label>
                        <input type="url" class="form-control" placeholder="https://www.mijnclub.nl/logo.png"
                               @bind="_theme.LogoUrl" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(_extractedLogoUrl))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@_extractedLogoUrl" alt="Logo" class="thema-logo-preview" />
                                <small class="text-muted">Gevonden logo (OG-afbeelding)</small>
                                <button class="btn btn-sm btn-outline-primary" type="button"
                                        @onclick="() => { _theme.LogoUrl = _extractedLogoUrl; StateHasChanged(); }">
                                    Gebruiken
                                </button>
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Opslaan
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetToDefaultAsync">Standaard herstellen</button>
                    </div>

                    @if (_saveMessage != null)
                    {
                        <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger") mt-3">@_saveMessage</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">Live preview — @(_modus == "dark" ? "donkere" : "lichte") weergave</div>
                <div class="card-body p-0">
                    <div class="thema-preview-header" style="--thema-primary:@Kleur("primary");">
                        @if (!string.IsNullOrWhiteSpace(_theme.LogoUrl))
                        {
                            <img src="@_theme.LogoUrl" alt="Logo" class="thema-preview-logo" />
                        }
                        <span class="thema-preview-titel" style="--thema-tekst-op-primary:@Kleur("textOnPrimary");">Zijbalk achtergrond</span>
                    </div>
                    <div class="thema-preview-body">
                        <button class="btn btn-primary me-2 thema-preview-primaire-knop"
                                style="--thema-primary:@Kleur("primary"); --thema-tekst-op-primary:@Kleur("textOnPrimary");">
                            Primaire knop
                        </button>
                        <button class="btn btn-outline-secondary me-2 thema-preview-secundaire-knop" style="--thema-secondary:@Kleur("secondary");">Secundaire knop</button>
                        <a href="#" class="thema-preview-link" style="--thema-accent:@Kleur("accent");">Link</a>
                    </div>
                    <div class="thema-preview-footer" style="--thema-card-bg:@Kleur("cardBg");">
                        <small class="text-muted">Kleuren worden direct toegepast in de zijbalk en knoppen</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
}
