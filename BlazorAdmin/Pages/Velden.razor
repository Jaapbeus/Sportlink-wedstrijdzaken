@page "/instellingen/velden"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Models
@using BlazorAdmin.Services

<PageTitle>Velden — Beheer</PageTitle>

<h1>Velden</h1>
<p class="text-muted">
    Aantal, type en beschikbaarheid van velden zijn volledig per club instelbaar — er is geen
    vaste aanname over kunstgras versus natuurgras. Trainingsbezetting kan per weekdag verschillen.
</p>

@if (loading)
{
    <p>Laden...</p>
}
else
{
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Velden</h2>
            <p class="text-muted mb-0">Naam, type (vrije tekst) en verlichting per veld.</p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNewVeld">Nieuw veld</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Veldnummer</th>
                <th>Naam</th>
                <th>Type</th>
                <th>Kunstlicht</th>
                <th>Actief</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in velden)
            {
                <tr class="@(!v.Actief ? "text-muted" : "")">
                    <td>@v.VeldNummer</td>
                    <td>@v.VeldNaam</td>
                    <td>@v.VeldType</td>
                    <td>@(v.HeeftKunstlicht ? "ja" : "nee")</td>
                    <td>@(v.Actief ? "ja" : "nee")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditVeld(v)">Bewerken</button>
                    </td>
                </tr>
            }
            @if (velden.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">Geen velden gevonden.</td></tr>
            }
        </tbody>
    </table>

    @if (editingVeld != null)
    {
        <hr />
        <h3>@(isNewVeld ? "Nieuw veld" : $"Bewerken: {editingVeld.VeldNaam}")</h3>
        <EditForm Model="editingVeld" OnValidSubmit="OpslaanVeldAsync">
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label class="form-label">Veldnummer</label>
                    <input class="form-control" type="number" min="1" @bind="editingVeld.VeldNummer" disabled="@(!isNewVeld)" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Naam</label>
                    <input class="form-control" @bind="editingVeld.VeldNaam" placeholder="bijv. veld 1" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Type</label>
                    <input class="form-control" list="veldtype-suggesties" @bind="editingVeld.VeldType" placeholder="kunstgras" />
                    <datalist id="veldtype-suggesties">
                        <option value="kunstgras" />
                        <option value="natuurgras" />
                    </datalist>
                    <small class="form-text text-muted">Vrije tekst — geen vaste lijst, elke club kiest zelf.</small>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label d-block">Kunstlicht</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingVeld.HeeftKunstlicht" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label d-block">Actief</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingVeld.Actief" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="() => editingVeld = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(veldMessage))
        {
            <div class="alert alert-info mt-3">@veldMessage</div>
        }
    }

    <hr class="mt-4" />
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Periodes</h2>
            <p class="text-muted mb-0">
                Een periode is een herbruikbaar regime met een vaste geldigheidsrange, bijv.
                "Zomerstop" of "Competitie". Koppel een veldbeschikbaarheid-venster hieronder aan
                een periode om er alléén tijdens die periode van te laten gelden — een venster
                zonder periode ("Standaard") geldt zoals voorheen het hele jaar, behalve wanneer een
                andere periode actief is.
            </p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNewPeriode">Nieuwe periode</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Naam</th>
                <th>Van</th>
                <th>Tot</th>
                <th>Actief</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in periodes.OrderBy(p => p.DatumVan))
            {
                <tr class="@(!p.Actief ? "text-muted" : "")">
                    <td>@p.Naam</td>
                    <td>@p.DatumVan</td>
                    <td>@p.DatumTot</td>
                    <td>@(p.Actief ? "ja" : "nee")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditPeriode(p)">Bewerken</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeletePeriodeAsync(p.Id)">
                            Verwijderen
                        </button>
                    </td>
                </tr>
            }
            @if (periodes.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">Geen periodes gedefinieerd — alle vensters gelden het hele jaar (standaardregime).</td></tr>
            }
        </tbody>
    </table>

    @if (editingPeriode != null)
    {
        <hr />
        <h3>@(isNewPeriode ? "Nieuwe periode" : $"Bewerken: {editingPeriode.Naam}")</h3>
        <EditForm Model="editingPeriode" OnValidSubmit="OpslaanPeriodeAsync">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Naam</label>
                    <input class="form-control" @bind="editingPeriode.Naam" placeholder="bijv. Zomerstop" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Van</label>
                    <input class="form-control" type="date" value="@editingPeriode.DatumVan"
                           @onchange="e => editingPeriode.DatumVan = e.Value?.ToString() ?? editingPeriode.DatumVan" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Tot</label>
                    <input class="form-control" type="date" value="@editingPeriode.DatumTot"
                           @onchange="e => editingPeriode.DatumTot = e.Value?.ToString() ?? editingPeriode.DatumTot" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label d-block">Actief</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingPeriode.Actief" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="() => editingPeriode = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(periodeMessage))
        {
            <div class="alert alert-info mt-3">@periodeMessage</div>
        }
    }

    <hr class="mt-4" />
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Veldbeschikbaarheid</h2>
            <p class="text-muted mb-0">Openingsvenster van het sportpark per veld per weekdag, optioneel per periode.</p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNewBeschikbaarheid">Nieuw venster</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Veld</th>
                <th>Dag</th>
                <th>Van</th>
                <th>Tot</th>
                <th>Zonsondergang</th>
                <th>Periode</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in beschikbaarheid.OrderBy(b => b.DagVanWeek).ThenBy(b => b.VeldNummer))
            {
                <tr>
                    <td>@b.VeldNaam</td>
                    <td>@DagNamen.Naam(b.DagVanWeek)</td>
                    <td>@b.BeschikbaarVanaf</td>
                    <td>@b.BeschikbaarTot</td>
                    <td>@(b.GebruikZonsondergang ? "ja" : "nee")</td>
                    <td>@(b.PeriodeNaam ?? "Standaard")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditBeschikbaarheid(b)">Bewerken</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteBeschikbaarheidAsync(b.Id)">
                            Verwijderen
                        </button>
                    </td>
                </tr>
            }
            @if (beschikbaarheid.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">Geen beschikbaarheidsvensters gevonden.</td></tr>
            }
        </tbody>
    </table>

    @if (editingBeschikbaarheid != null)
    {
        <hr />
        <h3>@(isNewBeschikbaarheid ? "Nieuw venster" : $"Bewerken: {editingBeschikbaarheid.VeldNaam}")</h3>
        <EditForm Model="editingBeschikbaarheid" OnValidSubmit="OpslaanBeschikbaarheidAsync">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Veld</label>
                    <select class="form-select" @bind="editingBeschikbaarheid.VeldNummer" disabled="@(!isNewBeschikbaarheid)">
                        <option value="0">— Kies een veld —</option>
                        @foreach (var v in velden)
                        {
                            <option value="@v.VeldNummer">@v.VeldNaam</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Dag</label>
                    <select class="form-select" @bind="editingBeschikbaarheid.DagVanWeek" disabled="@(!isNewBeschikbaarheid)">
                        @for (int d = 1; d <= 7; d++)
                        {
                            <option value="@d">@DagNamen.Naam(d)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Van</label>
                    <TimeInput @bind-Value="editingBeschikbaarheid.BeschikbaarVanaf" Placeholder="18:00" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Tot</label>
                    <TimeInput @bind-Value="editingBeschikbaarheid.BeschikbaarTot" Placeholder="22:00" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label d-block">Beperkt tot zonsondergang</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingBeschikbaarheid.GebruikZonsondergang" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Periode</label>
                    <select class="form-select" value="@(editingBeschikbaarheid.PeriodeId?.ToString() ?? "")"
                            @onchange="OnPeriodeGekozen">
                        <option value="">Standaard (hele jaar, buiten elke actieve periode)</option>
                        @foreach (var p in periodes)
                        {
                            <option value="@p.Id">@p.Naam (@p.DatumVan – @p.DatumTot)</option>
                        }
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="() => editingBeschikbaarheid = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(beschikbaarheidMessage))
        {
            <div class="alert alert-info mt-3">@beschikbaarheidMessage</div>
        }
    }

    <hr class="mt-4" />
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0">Trainingsschema</h2>
            <p class="text-muted mb-0">
                Terugkerende trainingsbezetting per veld per weekdag — telt mee als bezetting bij het
                plannen van wedstrijden en in e-mailreacties. Verschilt bewust per dag: een club kan
                maandag ruim en donderdag vol inrichten.
            </p>
        </div>
        <div class="col-auto align-self-center">
            <button class="btn btn-success" @onclick="StartNewTraining">Nieuw trainingsblok</button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Veld</th>
                <th>Dag</th>
                <th>Van</th>
                <th>Tot</th>
                <th>Omschrijving</th>
                <th>Actief</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in training.OrderBy(t => t.DagVanWeek).ThenBy(t => t.VeldNummer).ThenBy(t => t.VanTijd))
            {
                <tr class="@(!t.Actief ? "text-muted" : "")">
                    <td>@t.VeldNaam</td>
                    <td>@DagNamen.Naam(t.DagVanWeek)</td>
                    <td>@t.VanTijd</td>
                    <td>@t.TotTijd</td>
                    <td>@t.Omschrijving</td>
                    <td>@(t.Actief ? "ja" : "nee")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditTraining(t)">Bewerken</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteTrainingAsync(t.Id)">
                            Verwijderen
                        </button>
                    </td>
                </tr>
            }
            @if (training.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">Geen trainingsblokken gevonden.</td></tr>
            }
        </tbody>
    </table>

    @if (editingTraining != null)
    {
        <hr />
        <h3>@(isNewTraining ? "Nieuw trainingsblok" : $"Bewerken: {editingTraining.VeldNaam}")</h3>
        <EditForm Model="editingTraining" OnValidSubmit="OpslaanTrainingAsync">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Veld</label>
                    <select class="form-select" @bind="editingTraining.VeldNummer">
                        <option value="0">— Kies een veld —</option>
                        @foreach (var v in velden)
                        {
                            <option value="@v.VeldNummer">@v.VeldNaam</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Dag</label>
                    <select class="form-select" @bind="editingTraining.DagVanWeek">
                        @for (int d = 1; d <= 7; d++)
                        {
                            <option value="@d">@DagNamen.Naam(d)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Van</label>
                    <TimeInput @bind-Value="editingTraining.VanTijd" Placeholder="19:00" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Tot</label>
                    <TimeInput @bind-Value="editingTraining.TotTijd" Placeholder="20:30" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label d-block">Actief</label>
                    <input type="checkbox" class="form-check-input mt-2" @bind="editingTraining.Actief" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Omschrijving (optioneel)</label>
                <input class="form-control" @bind="editingTraining.Omschrijving" placeholder="bijv. JO15-2 training" />
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="() => editingTraining = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(trainingMessage))
        {
            <div class="alert alert-info mt-3">@trainingMessage</div>
        }
    }
}

