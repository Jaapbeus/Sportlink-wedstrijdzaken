@page "/oefenwedstrijd-aanmaken"
@inject AdminApiClient Api
@using BlazorAdmin.Services
@using BlazorAdmin.Models

<PageTitle>Oefenwedstrijd aanmaken — Admin</PageTitle>

<h1>Oefenwedstrijd aanmaken</h1>

<div class="alert alert-warning">
    <strong>Scaffolding, geen volledige implementatie (#997).</strong> De exacte Sportlink-requestbody
    is niet live bevestigd — elke aanmaak-aanroep is daarom altijd gesimuleerd (dry-run) totdat een
    mens dit met een echte netwerktrace heeft bevestigd. Verwijderen van een oefenwedstrijd en het
    vastleggen van een uitslag zijn in deze ronde bewust niet gebouwd.
</div>

<p class="text-muted">
    Maakt een nieuwe oefenwedstrijd ("clubwedstrijd") aan bij Sportlink Club. Vul de picklists
    hieronder pas in als je ze hebt geladen — teams en locaties komen rechtstreeks uit Sportlink.
</p>

<div class="mb-3">
    <button class="btn btn-outline-secondary btn-sm" disabled="@_picklistsLaden" @onclick="LaadPicklistsAsync">
        @if (_picklistsLaden)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Picklists laden
    </button>
    @if (!string.IsNullOrEmpty(_picklistsFout))
    {
        <div class="text-danger mt-1">@_picklistsFout</div>
    }
</div>

<div class="row g-3" style="max-width: 40rem;">
    <div class="col-6">
        <label class="form-label">Datum</label>
        <input type="date" class="form-control" @bind="_datum" />
    </div>
    <div class="col-6">
        <label class="form-label">Aanvangstijd</label>
        <TimeInput @bind-Value="_tijd" />
    </div>
    <div class="col-6">
        <label class="form-label">Duur (minuten)</label>
        <input type="number" class="form-control" @bind="_duur" />
    </div>
    <div class="col-6">
        <label class="form-label">Leeftijdscategorie</label>
        <input type="text" class="form-control" placeholder="bijv. JO10" @bind="_ageClassCode" />
    </div>
    <div class="col-12">
        <label class="form-label">Omschrijving</label>
        <input type="text" class="form-control" @bind="_omschrijving" />
    </div>
    <div class="col-6">
        <label class="form-label">Team</label>
        @if (_pickLists?.Teams is { Count: > 0 })
        {
            <select class="form-select" @bind="_publicHomeTeamId">
                <option value="">— kies een team —</option>
                @foreach (var team in _pickLists.Teams)
                {
                    <option value="@team.Id">@team.Naam</option>
                }
            </select>
        }
        else
        {
            <input type="text" class="form-control" placeholder="Team-ID (laad picklists voor een keuzelijst)" @bind="_publicHomeTeamId" />
        }
    </div>
    <div class="col-6">
        <label class="form-label">Tegenstander</label>
        <input type="text" class="form-control" placeholder="Vrije tekst of team-ID" @bind="_publicAwayTeamId" />
    </div>
    <div class="col-12">
        <label class="form-label">Locatie</label>
        @if (_pickLists?.Locations is { Count: > 0 })
        {
            <select class="form-select" @bind="_facilityId">
                <option value="">— kies een locatie —</option>
                @foreach (var locatie in _pickLists.Locations)
                {
                    <option value="@locatie.Id">@locatie.Naam</option>
                }
            </select>
        }
        else
        {
            <input type="text" class="form-control" placeholder="Locatie-ID (laad picklists voor een keuzelijst)" @bind="_facilityId" />
        }
    </div>
</div>

<div class="mt-3">
    <button class="btn btn-primary" disabled="@_bezig" @onclick="MaakAanAsync">
        @if (_bezig)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Oefenwedstrijd aanmaken
    </button>
</div>

@if (!string.IsNullOrEmpty(_melding))
{
    <div class="mt-3 alert @(_meldingFout ? "alert-danger" : "alert-info")">
        @_melding
        @if (!string.IsNullOrEmpty(_publicMatchIdResultaat))
        {
            <div>PublicMatchId: <code>@_publicMatchIdResultaat</code></div>
        }
    </div>
}

@code {
    private DateTime _datum = DateTime.Today;
    private string? _tijd = "19:00";
    private int _duur = 90;
    private string? _ageClassCode;
    private string? _omschrijving;
    private string? _publicHomeTeamId;
    private string? _publicAwayTeamId;
    private string? _facilityId;

    private bool _picklistsLaden;
    private string? _picklistsFout;
    private SportlinkClubMatchPickListsDto? _pickLists;

    private bool _bezig;
    private string? _melding;
    private bool _meldingFout;
    private string? _publicMatchIdResultaat;

    private async Task LaadPicklistsAsync()
    {
        _picklistsLaden = true;
        _picklistsFout = null;
        StateHasChanged();
        try
        {
            var result = await Api.GetSportlinkClubMatchPickListsAsync();
            if (result.Success)
                _pickLists = result.Data;
            else
                _picklistsFout = result.ErrorMessage ?? "Onbekende fout bij ophalen picklists.";
        }
        finally
        {
            _picklistsLaden = false;
        }
    }

    private async Task MaakAanAsync()
    {
        if (!TimeSpan.TryParse(_tijd, out var tijdSpan))
        {
            _meldingFout = true;
            _melding = "Ongeldige aanvangstijd.";
            return;
        }

        var matchDateTime = _datum.Date + tijdSpan;

        _bezig = true;
        _melding = null;
        _publicMatchIdResultaat = null;
        StateHasChanged();
        try
        {
            var result = await Api.PostSportlinkClubMatchAsync(
                matchDateTime, _duur, _ageClassCode, _omschrijving,
                _publicHomeTeamId, _publicAwayTeamId, _facilityId, fieldId: null);

            if (!result.Success)
            {
                _meldingFout = true;
                _melding = result.ErrorMessage ?? "Onbekende fout bij aanmaken.";
                return;
            }

            if (result.Data?.IsForcedDryRun == true)
            {
                _meldingFout = false;
                _melding = "Code-lock actief (#997): de aanmaak-body is nog niet live bevestigd bij Sportlink — " +
                            "deze aanroep is uitsluitend gesimuleerd en gelogd, er is niets naar Sportlink verstuurd.";
            }
            else if (result.Data?.IsDryRun == true)
            {
                _meldingFout = false;
                _melding = "Dry-run: niets gewijzigd in Sportlink Club — de aanroep is gesimuleerd en gelogd.";
            }
            else if (result.Data?.IsSuccess == true)
            {
                _meldingFout = false;
                _melding = "Oefenwedstrijd aangemaakt in Sportlink Club.";
            }
            else
            {
                _meldingFout = true;
                var violations = result.Data?.Violations;
                _melding = "Sportlink heeft de aanmaak afgewezen" + (violations is { Count: > 0 } ? $": {string.Join(", ", violations)}" : ".");
            }

            _publicMatchIdResultaat = result.Data?.PublicMatchId;
        }
        finally
        {
            _bezig = false;
        }
    }
}
