@page "/wijzigingsverzoeken"
@* Alle logica staat in Wijzigingsverzoeken.razor.cs (#1122). *@

<PageTitle>Wijzigingsverzoeken — Admin</PageTitle>

<h1>Wijzigingsverzoeken</h1>

<p class="text-muted">
    Wijzigingsverzoeken die tegenstanders in Sportlink Club hebben ingediend voor datum, tijd of
    accommodatie. Alleen <strong>openstaande</strong> verzoeken wachten op een beslissing van ons;
    de overige staan er ter referentie bij. Wedstrijdnummer en teams komen uit onze eigen
    wedstrijdgegevens — ontbreken ze bij een verzoek, dan is die wedstrijd nog niet gekoppeld.
</p>

@if (_laden)
{
    <p><span class="spinner-border spinner-border-sm"></span> Laden…</p>
}
else if (!string.IsNullOrEmpty(_fout))
{
    <div class="alert alert-danger">@_fout</div>
}
else if (_verzoeken == null || _verzoeken.Count == 0)
{
    <p class="text-muted">Geen wijzigingsverzoeken gevonden.</p>
}
else
{
    @* #1111: statusfilter als knoppenrij, standaard alleen "Openstaand" — naar het voorbeeld van
       Sportlinks eigen scherm. Elke knop toont het aantal in die categorie. *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="btn-group btn-group-sm" role="group" aria-label="Statusfilter">
            @foreach (var f in Filters)
            {
                var aantal = _verzoeken.Count(v => f.Match(v.RequestStatus));
                <button type="button"
                        class="btn @(_filter == f.Key ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => _filter = f.Key">
                    @f.Label <span class="badge bg-light text-dark ms-1">@aantal</span>
                </button>
            }
        </div>
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LaadVerzoekenAsync" title="Opnieuw laden">
            <i class="bi bi-arrow-clockwise"></i> Vernieuwen
        </button>
    </div>

    var zichtbaar = _verzoeken.Where(v => HuidigFilter.Match(v.RequestStatus)).ToList();

    @if (zichtbaar.Count == 0)
    {
        <p class="text-muted">Geen verzoeken met status "@HuidigFilter.Label".</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem;" title="Status"></th>
                        <th>Wedstrijdnr.</th>
                        <th>Thuis</th>
                        <th>Uit</th>
                        <th>Datum</th>
                        <th>Tijd</th>
                        <th>Accommodatie</th>
                        <th>Gevraagd</th>
                        <th>Reden</th>
                        <th style="width:11rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var verzoek in zichtbaar)
                    {
                        var isOpen = IsOpenstaand(verzoek.RequestStatus);
                        var id = verzoek.PublicRequestId ?? "";
                        var w = verzoek.Wedstrijd;
                        <tr>
                            <td>
                                <i class="bi @StatusIcoon(verzoek.RequestStatus)" title="@StatusLabel(verzoek.RequestStatus)"
                                   aria-label="@StatusLabel(verzoek.RequestStatus)"></i>
                            </td>
                            <td>@(w?.Wedstrijdnummer?.ToString() ?? "–")</td>
                            <td>@(w?.Thuisteam ?? "–")</td>
                            <td>@(w?.Uitteam ?? "–")</td>
                            <td>@(w?.Datum ?? verzoek.RequestData?.CurrentDate ?? "–")</td>
                            <td>@(w?.Tijd ?? verzoek.RequestData?.CurrentStartTime ?? "–")</td>
                            <td>@(w?.Accommodatie ?? verzoek.RequestData?.CurrentFacilityName ?? "–")</td>
                            <td>
                                @Gevraagd(verzoek.RequestData)
                            </td>
                            <td>
                                @verzoek.Reason
                                @if (!string.IsNullOrWhiteSpace(verzoek.Remarks))
                                {
                                    <div class="text-muted small">@verzoek.Remarks</div>
                                }
                            </td>
                            <td>
                                @if (isOpen && verzoek.PublicRequestId != null && verzoek.PublicMatchId != null)
                                {
                                    var status = Status(id);
                                    var bezig = status.Bezig;
                                    @if (!_afwijzenOpen.GetValueOrDefault(id))
                                    {
                                        <button class="btn btn-sm btn-success me-1" disabled="@bezig" title="Goedkeuren" aria-label="Goedkeuren"
                                                @onclick="() => HandelAfAsync(verzoek, isApprove: true)">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@bezig" title="Afwijzen (toelichting verplicht)" aria-label="Afwijzen"
                                                @onclick="() => _afwijzenOpen[id] = true">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            <input class="form-control form-control-sm" placeholder="Toelichting bij afwijzen (verplicht)"
                                                   value="@_toelichting.GetValueOrDefault(id)"
                                                   @onchange="e => _toelichting[id] = e.Value?.ToString()" />
                                            <div>
                                                <button class="btn btn-sm btn-danger me-1" disabled="@bezig" title="Afwijzen bevestigen"
                                                        @onclick="() => HandelAfAsync(verzoek, isApprove: false)">
                                                    <i class="bi bi-x-lg"></i> Afwijzen
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="Annuleren"
                                                        @onclick="() => _afwijzenOpen[id] = false">
                                                    Annuleren
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    @if (bezig)
                                    {
                                        <span class="spinner-border spinner-border-sm ms-1"></span>
                                    }
                                }
                                <Melding Status="Status(id)" Klasse="small" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
