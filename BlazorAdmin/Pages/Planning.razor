@page "/planning"
@inherits ClubSelectorPageBase
@using static BlazorAdmin.Services.DagplanningWeergaveHelpers
@* Alle logica staat in Planning.razor.cs (#1361, afgesplitst van het toenmalige Dagplanning.razor).
   Het Sportlink-paneel per wedstrijd is het component SportlinkMatchPanel. *@

<PageTitle>Planning — Admin</PageTitle>

<h1>Planning</h1>

@* ── Invoerbalk ── *@
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Datum</label>
                <input type="date" class="form-control" @bind="_datumDt" @bind:after="OnDatumChanged" />
            </div>
            @if (_sportlinkExtensionEnabled)
            {
                <div class="col-md-auto ms-auto">
                    <button type="button" class="btn btn-success" @onclick="ToggleAanmaken">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i> Wedstr. toevoegen
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@* #1468: het aanmaakformulier inline, met de gekozen datum; @key zet de datum opnieuw bij een andere dag. *@
@if (_sportlinkExtensionEnabled && _toonAanmaken)
{
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Wedstrijd toevoegen op @_datumDt.ToString("dd-MM-yyyy")</span>
            <button type="button" class="btn-close" aria-label="Sluiten" @onclick="ToggleAanmaken"></button>
        </div>
        <div class="card-body">
            <WedstrijdAanmakenFormulier BeginDatum="_datumDt" ToonIntro="false"
                                        OnAangemaakt="LoadVeldbezettingAsync" @key="DatumStr" />
        </div>
    </div>
}

@* ── Directe veldbezetting: wat staat er nu al gepland op deze datum (#566) ── *@
<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <span class="fw-semibold">Veldbezetting op @_datumDt.ToString("dd-MM-yyyy")</span>
        @if (_veldbezettingBezig)
        {
            <span class="spinner-border spinner-border-sm text-secondary ms-2" role="status" aria-hidden="true"></span>
        }
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_veldbezettingError))
        {
            <div class="alert alert-danger mb-0">@_veldbezettingError</div>
        }
        else if (!_veldbezettingBezig && _veldbezetting.Count == 0)
        {
            <p class="text-muted mb-0">Geen wedstrijden gepland op deze datum.</p>
        }
        else if (_veldbezetting.Count > 0)
        {
            var _vGantt = BouwVeldbezettingGanttItems();
            @if (_vGantt.Any())
            {
                <div class="veldbezetting-sticky mb-3">
                    <GanttChart Items="_vGantt" Hover="_hover" HoverGewijzigd="@(() => Task.CompletedTask)" />
                </div>
            }
            else
            {
                <p class="text-muted small">Nog geen wedstrijden met veld, tijd én bekende duur voor deze datum — zie de lijst hieronder.</p>
            }

            @if (AantalNietInSportlink > 0)
            {
                <div class="alert alert-warning py-2 small" role="status">
                    @AantalNietInSportlink @(AantalNietInSportlink == 1 ? "wedstrijd staat" : "wedstrijden staan") in onze gegevens maar niet in de veldplanner van Sportlink.
                    Sportlink is leidend: controleer of de wedstrijd daar is verwijderd of verplaatst en voer zo nodig een synchronisatie uit.
                </div>
            }

            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tijd</th>
                            <th>Team</th>
                            <th>Tegenstander</th>
                            <th>Veld</th>
                            <th>Competitie</th>
                            @if (_sportlinkExtensionEnabled)
                            {
                                <th title="Wat Sportlink Club over deze wedstrijd weet (read-only)">Sportlink</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _veldbezetting)
                        {
                            <tr class="@_hover.RijKlasse(item.WedstrijdCode)"
                                @onmouseover="() => _hover.Zet(item.WedstrijdCode)"
                                @onmouseout="() => _hover.Wis()">
                                <td>@(item.AanvangsTijd ?? "—")</td>
                                <td>
                                    @item.TeamNaam
                                    @if (item.NietInSportlink)
                                    {
                                        <span class="badge bg-warning text-dark ms-1"
                                              title="Deze wedstrijd staat in onze gegevens maar niet in de veldplanner van Sportlink.">Niet in Sportlink</span>
                                    }
                                    else if (item.WedstrijdCode == null && item.Bron == "Sportlink")
                                    {
                                        <span class="badge bg-secondary ms-1"
                                              title="Staat in de veldplanner van Sportlink maar niet in onze eigen gegevens, bijvoorbeeld een wedstrijd van een andere club op hetzelfde park.">Alleen in Sportlink</span>
                                    }
                                </td>
                                <td>@(item.Tegenstander ?? item.Uitteam ?? "—")</td>
                                <td>@(item.Veld ?? "—")</td>
                                <td>@(item.Competitiesoort ?? "—")</td>
                                @* ── Sportlink-kolom (#1361): dezelfde Toon/Open-in-Sportlink-acties als
                                   voorheen alleen op de vergelijkingstabel van Veld optimalisatie ── *@
                                @if (_sportlinkExtensionEnabled)
                                {
                                    <td class="tabel-compact">
                                        @if (item.WedstrijdCode == null)
                                        {
                                            <span class="text-muted" title="Geen wedstrijdcode bekend voor deze regel">—</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => _sportlinkKolom.Toggle(item.WedstrijdCode.Value)">
                                                @(_sportlinkKolom.IsUitgeklapt(item.WedstrijdCode.Value) ? "Verberg" : "Toon")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                                                    title="Open deze wedstrijd in Sportlink Club (nieuw tabblad)"
                                                    disabled="@_sportlinkKolom.Deeplink(item.WedstrijdCode.Value).Bezig"
                                                    @onclick="() => _sportlinkKolom.OpenInSportlinkAsync(item.WedstrijdCode.Value, Api, JS)">
                                                Open in Sportlink
                                            </button>
                                            @if (_sportlinkKolom.Deeplink(item.WedstrijdCode.Value).Bezig)
                                            {
                                                <span class="spinner-border spinner-border-sm text-secondary ms-2" role="status" aria-hidden="true"></span>
                                            }
                                            <Melding Status="_sportlinkKolom.Deeplink(item.WedstrijdCode.Value)" Klasse="small" />
                                        }
                                    </td>
                                }
                            </tr>
                            @if (_sportlinkExtensionEnabled && item.WedstrijdCode != null && _sportlinkKolom.IsUitgeklapt(item.WedstrijdCode.Value))
                            {
                                <tr @key="item.WedstrijdCode.Value">
                                    @* #1388: bg-light schakelt niet mee met het donkere thema; kaart-thema-bg
                                       (Planning.razor.css) volgt var(--theme-card-bg). *@
                                    <td colspan="6" class="kaart-thema-bg tabel-compact">
                                        <SportlinkMatchPanel WedstrijdCode="item.WedstrijdCode.Value" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ── Veldbezetting delen (#1364): HTML + PDF, datum zoals in de invoerbalk ── *@
<DeelPaneel Titel="Veldbezetting delen"
            Toelichting="De veldbezetting van de gekozen datum, om als e-mail te versturen of als bestand te bewaren."
            BestandsNaam="@ExportBestandsNaam"
            VerversSleutel="@ExportSleutel"
            HtmlOphalen="@(() => Api.GetVeldbezettingHtmlAsync(DatumStr))"
            PdfOphalen="@(_pdfExportIngeschakeld ? () => Api.GetVeldbezettingPdfAsync(DatumStr) : null)" />
