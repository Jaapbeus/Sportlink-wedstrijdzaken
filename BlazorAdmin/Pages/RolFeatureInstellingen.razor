@page "/sportlink-rol-instellingen"
@inherits ClubSelectorPageBase
@* Alle logica staat in RolFeatureInstellingen.razor.cs (#1390, opvolger van #1341/epic #1338). *@

<PageTitle>Rechten per rol</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Rechten per rol</h1>
    <a class="btn btn-outline-secondary btn-sm" href="instellingen">← Terug naar App instellingen</a>
</div>

<p class="text-muted">
    Bepaalt per rol welke menu-items zichtbaar zijn en welke Sportlink-acties mogen. <strong>Admin</strong> heeft
    dit altijd allemaal aan en staat daarom niet als kolom in de matrix; alleen een admin ziet de groep
    <strong>DEBUG</strong> en <strong>Rechten per rol</strong>. Het verbergen van een menu-item is
    gebruiksgemak: elk scherm en elke aanroep blijft server-side beveiligd, dus een aangezette rij geeft een
    rol nooit meer toegang dan de server toestaat. Voor de drie Sportlink-acties is deze instelling wel de
    leidende controle — een uitgeschakelde actie wordt ook door de server geweigerd. Zonder opgeslagen keuze
    staan alleen de items van het hoofdmenu aan; <strong>WZ Instellingen</strong> en <strong>Admin</strong>
    zijn standaard alleen voor admin.
</p>

@if (_laden)
{
    <span class="text-muted">Bezig met laden…</span>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    <div class="table-responsive">
        <table class="table align-middle rol-matrix">
            <thead>
                <tr>
                    <th>Functie</th>
                    @foreach (var rol in Rollen)
                    {
                        <th class="text-center">@RolLabels[rol]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var groep in Groepen)
                {
                    <tr class="table-group-row">
                        <td colspan="@(Rollen.Count + 1)">@groep.Key</td>
                    </tr>
                    @foreach (var rij in groep)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @rij.Label
                                    @if (rij.Avg)
                                    {
                                        <span class="badge text-bg-warning ms-2">AVG</span>
                                    }
                                </div>
                                @if (rij.Beschrijving is not null)
                                {
                                    <div class="text-muted small">@rij.Beschrijving</div>
                                }
                            </td>
                            @foreach (var rol in Rollen)
                            {
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               checked="@IsAan(rol, rij.FeatureKey)"
                                               @onchange="e => ZetAsync(rol, rij.FeatureKey, (bool)e.Value!)" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
