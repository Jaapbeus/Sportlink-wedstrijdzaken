@page "/veld-optimalisatie"
@inherits ClubSelectorPageBase
@using static BlazorAdmin.Services.DagplanningWeergaveHelpers
@* Alle logica staat in VeldOptimalisatie.razor.cs (#1361, afgesplitst van het toenmalige
   Dagplanning.razor). Het Sportlink-paneel per wedstrijd is het component SportlinkMatchPanel. *@

<PageTitle>Veld optimalisatie — Admin</PageTitle>

<h1>Veld optimalisatie</h1>

@* ── Invoerbalk ── *@
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Datum</label>
                <input type="date" class="form-control" @bind="_datumDt" @bind:after="OnDatumChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Buffer (min)</label>
                <input type="number" class="form-control" @bind="_bufferMinuten" min="0" max="60" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="AutoPlanAsync" disabled="@_bezig">
                    @(_bezig ? "Bezig..." : "Optimaliseer")
                </button>
            </div>
            <div class="col-md-5"></div>
        </div>
    </div>
</div>

@* #1334: direct onder de knop tonen — niet pas na een (soms hoge) kaart, waar een fout anders
   onopgemerkt bleef. *@
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_plan != null)
{
    @* ── Samenvatting banner ── *@
    @* #1388: bg-light was een Bootstrap-utility die niet meeschakelt met data-bs-theme="dark" —
       gaf een wit kaartje in een verder donker thema. kaart-thema-bg volgt var(--theme-card-bg). *@
    <div class="card mb-3 border-0 kaart-thema-bg">
        <div class="card-body py-2">
            <div class="row text-center g-2">
                <div class="col">
                    <div class="fs-5 fw-bold">@_plan.TotaalWedstrijden</div>
                    <small class="text-muted">Wedstrijden</small>
                </div>
                <div class="col">
                    <div class="fs-5 fw-bold @(_plan.ZonderVeld > 0 ? "tekst-attentie" : "tekst-ok")">
                        @_plan.ZonderVeld
                    </div>
                    <small class="text-muted">Zonder veld</small>
                </div>
                <div class="col">
                    <div class="fs-5 fw-bold @(_plan.ZonderTijd > 0 ? "tekst-attentie" : "tekst-ok")">
                        @_plan.ZonderTijd
                    </div>
                    <small class="text-muted">Zonder tijd</small>
                </div>
                <div class="col">
                    <div class="fs-5 fw-bold @(_plan.TeWijzigen > 0 ? "tekst-wijziging" : "tekst-ok")">
                        @_plan.TeWijzigen
                    </div>
                    <small class="text-muted">Te wijzigen</small>
                </div>
                @if (_plan.NietInplanbaar > 0)
                {
                    <div class="col">
                        <div class="fs-5 fw-bold tekst-probleem">@_plan.NietInplanbaar</div>
                        <small class="text-muted">Niet inplanbaar</small>
                    </div>
                }
                <div class="col">
                    <div class="fs-5 fw-bold">@(_plan.GeschatteEindTijd ?? "—")</div>
                    <small class="text-muted">Optimale eindtijd</small>
                </div>
            </div>
        </div>
    </div>

    @* ── Vergelijking: twee tabs met identieke opbouw (#689) ──
       Eén kaart met de tabs op het hoogste niveau. Elke tab bevat op dezelfde plek eerst de
       veldvisual en daaronder de wedstrijdenlijst van diezelfde stand. Wisselen werkt daardoor als
       een flip book: de visuals staan op gelijke hoogte, dus het oog springt niet en het verschil in
       veldbezetting valt direct op.

       #1361: Huidig staat als eerste tab en is de standaard-actieve tab (was Optimaal) — de
       eigenaar wil bij binnenkomst eerst de bestaande Sportlink-stand zien. *@
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-3 flex-wrap">
            <ul class="nav nav-tabs card-header-tabs mb-0">
                <li class="nav-item">
                    <button class="nav-link @(_visTab == "huidig" ? "active" : "")"
                            @onclick='() => _visTab = "huidig"'>Huidig</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_visTab == "optimaal" ? "active" : "")"
                            @onclick='() => _visTab = "optimaal"'>&#128197; Optimaal</button>
                </li>
            </ul>
            @* #689: hier stond "Eindtijd: hh:mm", alleen in de Optimaal-tab. Dat gaf twee problemen:
               het dupliceerde de tegel "Optimale eindtijd" uit de samenvattingsbalk hierboven, en
               omdat het element in de Huidig-tab wegviel werd de kaartkop daar smaller. Op een
               1440px-scherm wrapte de kop daardoor anders en schoof de tijdlijn 21 pixels — precies
               het springen dat deze herstructurering moet wegnemen. De eindtijd staat al in de
               samenvattingsbalk, dus hier weggelaten. *@
            @if (IsAllstars && _plan.TeWijzigen > 0 && _visTab == "optimaal")
            {
                <button class="btn btn-sm btn-warning ms-auto" @onclick="ToepassenAsync" disabled="@_bezig">
                    @(_bezig ? "Toepassen..." : $"Toepassen in testmodus ({_plan.TeWijzigen})")
                </button>
            }
        </div>
        <div class="card-body p-3">
            @{
                bool _isOptimaal = _visTab == "optimaal";
                var _gantt = BouwGanttItems(_isOptimaal);
            }
            @if (!_gantt.Any())
            {
                <p class="text-muted mb-0">
                    @(_isOptimaal
                        ? "Geen ingeplande wedstrijden — klik 'Optimaliseer' eerst."
                        : "Geen wedstrijden met veld én tijd in de huidige situatie.")
                </p>
            }
            else
            {
                var _velden = _gantt
                    .Select(g => g.VeldNaam).Distinct()
                    .OrderBy(v => v.StartsWith("Kunstgras", StringComparison.OrdinalIgnoreCase) ? "0" + v : "1" + v)
                    .ToList();
                int _sMin = (_gantt.Min(g => (int)g.Aanvang.ToTimeSpan().TotalMinutes) / 60) * 60;
                int _eMin = (((int)_gantt.Max(g => g.Einde.ToTimeSpan().TotalMinutes) + 59) / 60) * 60;
                if (_eMin <= _sMin) _eMin = _sMin + 60;
                int _totMin = _eMin - _sMin;

                @* Legenda *@
                <div class="d-flex flex-wrap gap-3 mb-2 small">
                    <span class="fw-semibold text-muted me-1">Status:</span>
                    <span><span class="gantt-legenda-dot gantt-legenda-dot-ongewijzigd"></span> Ongewijzigd</span>
                    <span><span class="gantt-legenda-dot gantt-legenda-dot-wijziging"></span> Wijziging</span>
                    <span><span class="gantt-legenda-dot gantt-legenda-dot-nieuw"></span> Nieuw slot</span>
                    <span class="ms-3 fw-semibold text-muted me-1">Voorkeurstijd:</span>
                    <span><span class="gantt-legenda-balk gantt-legenda-balk-optijd"></span> Op tijd</span>
                    <span><span class="gantt-legenda-balk gantt-legenda-balk-klein"></span> &le;15 min afwijking</span>
                    <span><span class="gantt-legenda-balk gantt-legenda-balk-groot"></span> &gt;15 min afwijking</span>
                </div>

                @* #689: boven de tijdlijn staat alléén de legenda, die in beide tabs identiek is.
                   Elk element daarboven dat per tab van hoogte verschilt, verschuift de tijdlijn bij
                   het wisselen — en juist dat springen maakt het vergelijken onbruikbaar. Dat is hier
                   twee keer misgegaan: eerst met een sleep-hint die alleen in de Optimaal-tab stond
                   (50px), daarna met dezelfde hint in beide tabs maar met verschillende tekstlengte,
                   die op een 1440px-scherm in een verschillend aantal regels wrapte (21px). De
                   toelichting staat daarom nu ónder de tijdlijn, waar haar hoogte niets verschuift. *@
                <div class="gantt-scroll">
                    @* Tijdas-header *@
                    <div class="gantt-tijdas-header">
                        <div class="gantt-label-gutter"></div>
                        <div class="gantt-tijdas-lijn">
                            @for (int _h = _sMin; _h <= _eMin; _h += 60)
                            {
                                string _lftH = GanttPct(_h - _sMin, _totMin);
                                <div class="gantt-uur-label" style="--gantt-left:@(_lftH)%; --gantt-transform:@GanttLabelTransform(_h, _sMin, _eMin);">
                                    @GanttUurLabel(_h)
                                </div>
                            }
                        </div>
                    </div>

                    @* Veld-rijen — sleepbaar bij de optimale planning (#666) *@
                    @{ int _rijIdx = 0; }
                    @foreach (var _veld in _velden)
                    {
                        int _rij = _rijIdx++;
                        string _veldNaam = _veld;
                        <div class="gantt-veld-rij">
                            <div class="gantt-veld-label">
                                @_veld
                            </div>
                            <div id="gantt-rij-@_rij"
                                 class="gantt-veld-track"
                                 ondragover="event.preventDefault();"
                                 @ondrop="@(e => SleepDrop(_veldNaam, _rij, _sMin, _totMin, e))">
                                @* Uurlijnen *@
                                @for (int _h = _sMin + 60; _h < _eMin; _h += 60)
                                {
                                    <div class="gantt-uurlijn" style="--gantt-left:@(GanttPct(_h - _sMin, _totMin))%;"></div>
                                }
                                @* Wedstrijdblokken *@
                                @foreach (var gi in _gantt.Where(g => g.VeldNaam == _veld))
                                {
                                    string _lft = GanttPct((int)gi.Aanvang.ToTimeSpan().TotalMinutes - _sMin, _totMin);
                                    string _wdt = GanttPct(gi.DuurMinuten, _totMin);
                                    var (_topVal, _hgtVal) = GanttLayout.Bereken(gi.SubPos, gi.Fractie);
                                    string _top = GanttPct((int)_topVal, 100);
                                    string _hgt = GanttPct((int)_hgtVal, 100);
                                    string _voorkeurBalk = GanttVoorkeurBalkKleur(gi.VoorkeurAfwijking, gi.VoorkeurTijd, KleineAfwijkingDrempelMinuten);
                                    string _tooltip = GanttTooltip(gi);
                                    bool _sleepbaar = gi.Bron != null;
                                    bool _handmatig = gi.Bron != null && _handmatigAangepast.Contains(gi.Bron);
                                    <div title="@_tooltip"
                                         draggable="@(_sleepbaar ? "true" : "false")"
                                         @ondragstart="@(e => SleepStart(gi, e))"
                                         class="gantt-blok gantt-blok-sleepbaar"
                                         style="--gantt-left:calc(@(_lft)% + 2px); --gantt-width:calc(@(_wdt)% - 4px);
                                                --gantt-top:calc(@(_top)% + 2px); --gantt-height:calc(@(_hgt)% - 4px);
                                                --gantt-bg:@GanttKleur(gi.Status);
                                                --gantt-cursor:@(_sleepbaar ? "grab" : "default");
                                                --gantt-outline:@(_handmatig ? "2px dashed #fff" : "none");">
                                        @* Voorkeurstijd-indicator: gekleurde balk bovenaan het blok *@
                                        @if (!string.IsNullOrEmpty(_voorkeurBalk))
                                        {
                                            <div class="gantt-voorkeur-balk" style="--gantt-voorkeur-kleur:@_voorkeurBalk;"></div>
                                        }
                                        <div class="gantt-blok-tijd" style="--gantt-margin-top:@(string.IsNullOrEmpty(_voorkeurBalk) ? "0" : "4px");">
                                            @gi.Aanvang.ToString("HH:mm")
                                        </div>
                                        <div class="gantt-blok-label">
                                            @GanttLabel(gi.Label)
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <div class="gantt-as-onderlijn"></div>
                </div>
            }

            @* Toelichting per tab — onder de tijdlijn, zie de uitleg hierboven. *@
            <p class="text-muted small mb-0 mt-2">
                @if (_isOptimaal)
                {
                    <i class="bi bi-arrows-move me-1" aria-hidden="true"></i>
                    <text>
                        Sleep een wedstrijd naar een andere tijd of een ander veld. De tijd springt op stappen
                        van 5 minuten; de tabel en de eindtijd lopen mee. Handmatig verplaatste wedstrijden
                        krijgen een stippellijn.
                    </text>
                }
                else
                {
                    <i class="bi bi-lock me-1" aria-hidden="true"></i>
                    <text>
                        Dit is de stand zoals die nu in Sportlink staat. Niet te verslepen — wissel naar
                        Optimaal om te schuiven. De kolom Wijziging laat zien wat de planner zou aanpassen.
                    </text>
                }
            </p>

            @* Conflicten staan onder de tijdlijn, om dezelfde reden als de toelichting. *@
            @if (_isOptimaal && _conflicten.Count > 0)
            {
                <div class="alert alert-warning py-2 small mt-2 mb-0">
                    <strong>Let op — deze planning kan zo niet:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var c in _conflicten)
                        {
                            <li>@c</li>
                        }
                    </ul>
                </div>
            }

            @* ── Wedstrijdenlijst van dézelfde stand (#689) ──
               Bewust dezelfde kolommen in beide tabs, zodat de rijen tussen "Optimaal" en "Huidig"
               op precies dezelfde regel staan. Alleen Veld en Tijd komen uit een andere bron.

               De statusbadge staat in béide tabs. Het issue vroeg alleen om de badge in de
               Optimaal-tab, om de diff-informatie niet te verliezen nu de kolommen-naast-elkaar-tabel
               verdwijnt. In de Huidig-tab is dezelfde badge juist het nuttigst: je ziet dáár welke
               wedstrijd gaat verschuiven, en flipt dan naar Optimaal om te zien waarheen. *@
            <hr class="my-3" />

            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <span class="fw-semibold me-1">
                    @(_isOptimaal ? "Wedstrijden in de optimale planning" : "Wedstrijden in de huidige situatie")
                </span>
                @* Het filter geldt voor beide tabs: filter je op "Wijzigingen", dan vergelijk je in
                   beide standen dezelfde deelverzameling. *@
                <div class="btn-group btn-group-sm">
                    <button class="btn @(_filter == "alles" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => _filter = "alles"'>Alles (@_plan.TotaalWedstrijden)</button>
                    <button class="btn @(_filter == "wijzigingen" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => _filter = "wijzigingen"'>Wijzigingen (@_plan.TeWijzigen)</button>
                    @if (_plan.NietInplanbaar > 0)
                    {
                        <button class="btn @(_filter == "probleem" ? "btn-danger" : "btn-outline-danger")"
                                @onclick='() => _filter = "probleem"'>Probleem (@_plan.NietInplanbaar)</button>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Wedstrijd</th>
                            <th>Veld</th>
                            <th>Tijd</th>
                            <th>Competitie</th>
                            <th title="Gewenste tijd en de afwijking daarvan in de optimale planning">Voorkeurstijd</th>
                            <th title="Verplaatst de planner deze wedstrijd t.o.v. de huidige stand?">Wijziging</th>
                            @if (_sportlinkExtensionEnabled)
                            {
                                <th title="Wat Sportlink Club over deze wedstrijd weet (read-only)">Sportlink</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in GefilterdeLijst())
                        {
                            <tr class="@RowClass(item.Status)">
                                <td class="tabel-compact">
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.Wedstrijd) ? item.TeamNaam : item.Wedstrijd)</div>
                                </td>

                                @if (_isOptimaal)
                                {
                                    @* Veld en tijd zoals de planner ze voorstelt *@
                                    @if (item.Status == "niet-inplanbaar")
                                    {
                                        <td colspan="2" class="tabel-compact">
                                            <span class="text-danger" title="@item.NietInplanbaaarReden">
                                                &#10007; @(item.NietInplanbaaarReden ?? "Niet inplanbaar")
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        @* Onbekend team: huidige situatie blijft staan, gedempt en zonder
                                           foutmelding (#487) *@
                                        var _gedempt = item.Status is "ongewijzigd" or "onbekend-team";
                                        <td class="tabel-compact">
                                            <span class="@(_gedempt ? "" : "fw-bold")">@(item.OptimaalVeld ?? "—")</span>
                                        </td>
                                        <td class="tabel-compact">
                                            <span class="@(_gedempt ? "" : "fw-bold")">@(item.OptimaalTijd ?? "—")</span>
                                        </td>
                                    }
                                }
                                else
                                {
                                    @* Veld en tijd zoals ze nu in Sportlink staan *@
                                    <td class="tabel-compact">
                                        @if (!item.HeeftVeld)
                                        {
                                            <span class="tekst-attentie">&#10007; Geen veld</span>
                                        }
                                        else
                                        {
                                            <span>@item.HuidigeVeld</span>
                                        }
                                    </td>
                                    <td class="tabel-compact">
                                        @if (!item.HeeftTijd)
                                        {
                                            <span class="tekst-attentie">&#10007; Geen tijd</span>
                                        }
                                        else
                                        {
                                            <span>@item.HuidigeTijd</span>
                                        }
                                    </td>
                                }

                                <td class="tabel-compact">@(item.Competitiesoort ?? "—")</td>

                                @* Voorkeurstijd los van de wijzig-status (#666): een wedstrijd kan
                                   ongewijzigd blijven én tóch ver van de voorkeurstijd liggen.
                                   De afwijking is berekend t.o.v. de optimale planning, dus die wordt
                                   alleen in die tab getoond — anders zou hij bij "Huidig" iets beweren
                                   over een stand waarop hij niet is berekend. *@
                                <td class="tabel-compact">
                                    @if (string.IsNullOrWhiteSpace(item.VoorkeurTijd))
                                    {
                                        <span class="text-muted" title="Geen voorkeurstijd voor dit team en geen standaardtijd voor de leeftijdscategorie">—</span>
                                    }
                                    else if (_isOptimaal)
                                    {
                                        <span class="badge @VoorkeurBadgeClass(item.VoorkeurStatus)"
                                              title="@VoorkeurTitel(item)">
                                            @item.VoorkeurTijd@VoorkeurAfwijkingTekst(item.VoorkeurAfwijkingMinuten)
                                        </span>
                                        <span class="text-muted ms-1" tabel-extra-compact">@VoorkeurBronLabel(item.VoorkeurBron)</span>
                                        @if (item.VoorkeurVeldToegepast == false)
                                        {
                                            <span class="badge badge-secundair ms-1"
                                                  title="Voorkeursveld was niet beschikbaar; de planner koos een ander veld">
                                                ander veld
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutraal"
                                              title="Gewenste tijd volgens @VoorkeurBronLabel(item.VoorkeurBron). De afwijking staat in de tab Optimaal.">
                                            @item.VoorkeurTijd
                                        </span>
                                    }
                                </td>

                                <td>
                                    @switch (item.Status)
                                    {
                                        case "ongewijzigd":
                                            <span class="badge badge-neutraal" title="De planner laat deze wedstrijd staan">Ongewijzigd</span>
                                            break;
                                        case "nieuw-slot":
                                            <span class="badge badge-status-nieuw-slot">Nieuw</span>
                                            break;
                                        case "wijziging":
                                            <span class="badge badge-status-wijziging">Wijzig</span>
                                            break;
                                        case "niet-inplanbaar":
                                            <span class="badge badge-status-niet-inplanbaar">Probleem</span>
                                            break;
                                        case "onbekend-team":
                                            <span class="badge badge-secundair">Onbekend</span>
                                            break;
                                    }
                                </td>

                                @if (_sportlinkExtensionEnabled)
                                {
                                    <td class="tabel-compact">
                                        @if (item.WedstrijdCode == null)
                                        {
                                            <span class="text-muted" title="Geen wedstrijdcode bekend voor deze regel">—</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => _sportlinkKolom.Toggle(item.WedstrijdCode.Value)">
                                                @(_sportlinkKolom.IsUitgeklapt(item.WedstrijdCode.Value) ? "Verberg" : "Toon")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                                                    title="Open deze wedstrijd in Sportlink Club (nieuw tabblad)"
                                                    disabled="@_sportlinkKolom.Deeplink(item.WedstrijdCode.Value).Bezig"
                                                    @onclick="() => _sportlinkKolom.OpenInSportlinkAsync(item.WedstrijdCode.Value, Api, JS)">
                                                Open in Sportlink
                                            </button>
                                            @if (_sportlinkKolom.Deeplink(item.WedstrijdCode.Value).Bezig)
                                            {
                                                <span class="spinner-border spinner-border-sm text-secondary ms-2" role="status" aria-hidden="true"></span>
                                            }
                                            <Melding Status="_sportlinkKolom.Deeplink(item.WedstrijdCode.Value)" Klasse="small" />
                                        }
                                    </td>
                                }
                            </tr>
                            @if (_sportlinkExtensionEnabled && item.WedstrijdCode != null && _sportlinkKolom.IsUitgeklapt(item.WedstrijdCode.Value))
                            {
                                <tr @key="item.WedstrijdCode.Value">
                                    <td colspan="7" class="kaart-thema-bg tabel-compact">
                                        <SportlinkMatchPanel WedstrijdCode="item.WedstrijdCode.Value" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_toepassenMelding))
        {
            <div class="card-footer">
                <div class="alert @(_toepassenFout ? "alert-danger" : "alert-success") mb-0 py-2">
                    @_toepassenMelding
                    @if (!_toepassenFout)
                    {
                        <button class="btn btn-sm btn-outline-success ms-3" @onclick="AutoPlanAsync">Herlaad plan</button>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Deelbare weergave van de berekende planning ── *@
    @if (!string.IsNullOrEmpty(HuidigeExportHtml))
    {
        <details class="mb-3">
            <summary class="text-muted export-summary">Planning delen (HTML voor e-mail of download)</summary>
            <div class="card mt-2">
                <div class="card-body">
                    <p class="text-muted small">
                        Weergave van de @(_visTab == "optimaal" ? "optimale" : "huidige") planning zoals hierboven
                        gekozen. Handig om als e-mail te versturen of als bestand te bewaren.
                    </p>
                    <div class="mb-2">
                        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="KopieerEmailHtmlAsync">
                            @(_kopieerStatus ?? "Kopieer HTML")
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadHtmlAsync">
                            Download HTML
                        </button>
                    </div>
                    <div class="border rounded overflow-hidden">
                        @* sandbox zonder allow-scripts: de HTML wordt server-side gegenereerd uit
                           Sportlink-data (team-/tegenstandernamen). Defense in depth tegen XSS,
                           onafhankelijk van server-side encoding. (#603) *@
                        <iframe srcdoc="@ExportHtmlZonderScript"
                                sandbox="allow-same-origin"
                                class="export-iframe"
                                title="Veld optimalisatie"></iframe>
                    </div>
                </div>
            </div>
        </details>
    }
}
