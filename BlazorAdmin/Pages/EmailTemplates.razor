@page "/email-templates"
@inherits ClubSelectorPageBase
@using BlazorAdmin.Services

<PageTitle>E-mailtemplates — Beheer</PageTitle>

<h1>E-mailtemplates</h1>
<p class="text-muted">Elke template heeft een hardcoded standaard in de code. Klik <strong>Aanpassen</strong> om de standaard te vervangen. Klik <strong>Verwijder aanpassing</strong> om terug te keren naar de hardcoded standaard.</p>

@if (loading)
{
    <p>Laden...</p>
}
else
{
    @* ── Email voetnote ── *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Gedeelde e-mail voetnoot</strong>
            <small class="text-muted">Wordt automatisch onder elke uitgaande e-mail geplaatst</small>
        </div>
        <div class="card-body">
            <textarea class="form-control font-monospace" rows="4" @bind="voetnoot"
                      placeholder="Bijv: Met vriendelijke groet,&#10;&#10;Jan de Vries&#10;Coördinator thuiswedstrijden&#10;&#10;WIST U DAT: ..."></textarea>
            <div class="mt-2 d-flex gap-2 align-items-center">
                <button class="btn btn-primary btn-sm" @onclick="OpslaanVoetnootAsync">Opslaan</button>
                @if (!string.IsNullOrEmpty(voetnootMessage))
                {
                    <small class="text-success">@voetnootMessage</small>
                }
            </div>
        </div>
    </div>

    @* ── Template tabel ── *@
    <div class="mb-2 d-flex justify-content-end">
        <button class="btn btn-success btn-sm" @onclick="StartNewTemplate">+ Nieuwe template</button>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Template</th>
                <th>Naam</th>
                <th>Categorie</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in templates)
            {
                <tr>
                    <td><strong>@t.TemplateKey</strong></td>
                    <td>@(t.Onderwerp.Length > 80 ? t.Onderwerp[..80] + "..." : t.Onderwerp)</td>
                    <td>
                        @{
                            var (cat, catCss) = GetCategorie(t.TemplateKey);
                        }
                        <span class="badge @catCss">@cat</span>
                    </td>
                    <td>@(t.Actief ? "Aangepast" : "Standaard")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(t)">Aanpassen</button>
                        @if (t.Actief)
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => ResetAsync(t.TemplateKey)">
                                Verwijder aanpassing
                            </button>
                        }
                    </td>
                </tr>
            }
            @if (templates.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">Geen templates in database — defaults zijn actief.</td></tr>
            }
        </tbody>
    </table>

    @* ── Bewerk-formulier ── *@
    @if (editing != null)
    {
        <hr />
        <h3>@(isNew ? "Nieuwe template" : $"Bewerken: {editing.TemplateKey}")</h3>
        <EditForm Model="editing" OnValidSubmit="OpslaanTemplateAsync">
            <div class="mb-3">
                <label class="form-label">Template key</label>
                @if (isNew)
                {
                    <select class="form-select" value="@editing.TemplateKey" @onchange="OnTemplateKeyChange">
                        <option value="">— kies een type —</option>
                        <optgroup label="Beschikbaarheid">
                            <option value="beschikbaarheid_check">beschikbaarheid_check — antwoord op veld-/tijdvraag</option>
                        </optgroup>
                        <optgroup label="Herplanning">
                            <option value="herplan_verzoek">herplan_verzoek — antwoord op herplanningsverzoek</option>
                        </optgroup>
                        <optgroup label="Bevestiging">
                            <option value="bevestiging">bevestiging — bevestiging van eerder voorstel</option>
                        </optgroup>
                        <optgroup label="Teambegeleiding">
                            <option value="team_contact_opvragen">team_contact_opvragen — auto-reply na doorsturen begeleiding</option>
                        </optgroup>
                        <optgroup label="Overig">
                            <option value="buiten_scope">buiten_scope — antwoord op niet-herkend verzoek</option>
                        </optgroup>
                    </select>
                    <small class="form-text text-muted">
                        Kies de template die de code zal gebruiken als override. Lege DB-rij = hardcoded default blijft actief.
                    </small>
                }
                else
                {
                    <input class="form-control" value="@editing.TemplateKey" disabled />
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Onderwerp</label>
                <input class="form-control" @bind="editing.Onderwerp" />
            </div>
            <div class="mb-3">
                <label class="form-label">Body template</label>
                <textarea class="form-control" rows="10" @bind="editing.BodyTemplate"></textarea>
                <small class="form-text text-muted">
                    Beschikbare placeholders: {{voornaam}}, {{aanhef}}, {{datum}}, {{team}}, {{tegenstander}}, {{aanvangstijd}}<br />
                    De voetnoot uit het bovenstaande vak wordt automatisch toegevoegd na de body.
                </small>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="actief" @bind="editing.Actief" />
                <label class="form-check-label" for="actief">Actief</label>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary" @onclick="() => editing = null">Annuleren</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(templateMessage))
        {
            <div class="alert alert-info mt-3">@templateMessage</div>
        }
    }
}
