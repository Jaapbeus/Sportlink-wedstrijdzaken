@* Alle logica staat in NavMenu.razor.cs (#1647). *@

@* ── ALLSTARS testmodus-banner: altijd zichtbaar bovenin de sidebar ── *@
@if (IsTestmodus)
{
    <div class="allstars-banner px-3 py-2 text-center">
        <div class="fw-bold" style="font-size:0.85rem;">&#9881; TESTMODUS</div>
        <div style="font-size:0.75rem; opacity:0.9;">AllStars FC — geen productiedata</div>
    </div>
}

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            @if (!string.IsNullOrWhiteSpace(ThemeService.LogoUrl))
            {
                <img src="@ThemeService.LogoUrl" alt="Club logo" style="height:28px; width:auto; object-fit:contain;" />
            }
            @(ClubSelector.SelectedClubName ?? "Admin")
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@* Menuvolgorde en -groepen volgens #1647. Een item verschijnt alleen als de rol er volgens "Rechten per rol"
   recht op heeft (UI-gemak; de server autoriseert elk endpoint zelf). Conventie sidebar-labels (#1314):
   een label wrapt nooit op twee regels — lange labels worden afgekapt (.nav-label) en staan volledig in de tooltip. *@
<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (Zichtbaar.Mag(MenuKeys.Dashboard))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-1" aria-hidden="true"></i> Dashboard
                </NavLink>
            </div>
        }

        @* DEBUG: uitsluitend voor een beheerder (de server dwingt de rol per endpoint af; dit is UX). *@
        @if (Auth.IsAdmin)
        {
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100 d-flex justify-content-between align-items-center px-0 py-1"
                        @onclick="() => ToggleGroep(GroepDebug)" @onclick:stopPropagation="true" aria-expanded="@IsOpen(GroepDebug)">
                    <span><i class="bi bi-bug me-1" aria-hidden="true"></i> DEBUG</span>
                    <i class="bi @(IsOpen(GroepDebug) ? "bi-chevron-down" : "bi-chevron-right") ms-1 small" aria-hidden="true"></i>
                </button>
                @if (IsOpen(GroepDebug))
                {
                    <div class="nav-subitems ps-2">
                        <div class="nav-item">
                            <NavLink class="nav-link py-1" href="email-tester" title="Email-tester (dry-run)">
                                <i class="bi bi-envelope-check me-1" aria-hidden="true"></i> <span class="nav-label">Email-tester (dry-run)</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link py-1" href="leermomenten" title="AI-leermomenten">
                                <i class="bi bi-lightbulb me-1" aria-hidden="true"></i> <span class="nav-label">AI-leermomenten</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link py-1" href="feedback" title="Feedback">
                                <i class="bi bi-chat-dots me-1" aria-hidden="true"></i> <span class="nav-label">Feedback</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link py-1" href="email-log" title="E-maillog">
                                <i class="bi bi-inbox me-1" aria-hidden="true"></i> <span class="nav-label">E-maillog</span>
                            </NavLink>
                        </div>
                    </div>
                }
            </div>
        }

        @* Teambegeleiding staat bewust vooraan: meest gebruikte scherm (#669) *@
        @if (Zichtbaar.Mag(MenuKeys.Teambegeleiding))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="teambegeleiding">
                    <i class="bi bi-people me-1" aria-hidden="true"></i> Teambegeleiding
                </NavLink>
            </div>
        }
        @if (Zichtbaar.Mag(MenuKeys.Planning))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="planning">
                    <i class="bi bi-calendar-week me-1" aria-hidden="true"></i> Planning
                </NavLink>
            </div>
        }
        @* #1122/#1468: de twee extensie-schermen alleen tonen als de Sportlink Web Extension aan staat —
           zelfde regel als de Sportlink-kolom in Planning (#989) — én als de rol er recht op heeft.
           Inschakelen gebeurt via Admin → Sportlink Web Extension, dat voor een beheerder altijd zichtbaar blijft. *@
        @if (ClubSelector.SportlinkExtensionEnabled && Zichtbaar.Mag(MenuKeys.WedstrijdAanmaken))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="wedstrijd-aanmaken">
                    <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i> Wedstrijd aanmaken
                </NavLink>
            </div>
        }
        @if (ClubSelector.SportlinkExtensionEnabled && Zichtbaar.Mag(MenuKeys.Wijzigingsverzoeken))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="wijzigingsverzoeken">
                    <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Wijzigingsverzoeken
                </NavLink>
            </div>
        }
        @if (Zichtbaar.Mag(MenuKeys.VeldOptimalisatie))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="veld-optimalisatie">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i> Veld optimalisatie
                </NavLink>
            </div>
        }

        @if (ToonWzInstellingen)
        {
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100 d-flex justify-content-between align-items-center px-0 py-1"
                        @onclick="() => ToggleGroep(GroepWz)" @onclick:stopPropagation="true" aria-expanded="@IsOpen(GroepWz)">
                    <span><i class="bi bi-gear me-1" aria-hidden="true"></i> WZ Instellingen</span>
                    <i class="bi @(IsOpen(GroepWz) ? "bi-chevron-down" : "bi-chevron-right") ms-1 small" aria-hidden="true"></i>
                </button>
                @if (IsOpen(GroepWz))
                {
                    <div class="nav-subitems ps-2">
                        @if (Zichtbaar.Mag(MenuKeys.Speeltijden))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="instellingen/speeltijden" title="Speeltijden">
                                    <i class="bi bi-clock me-1" aria-hidden="true"></i> <span class="nav-label">Speeltijden</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.Velden))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="instellingen/velden" title="Velden">
                                    <i class="bi bi-grid-3x3 me-1" aria-hidden="true"></i> <span class="nav-label">Velden</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.Voorkeurstijden))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="voorkeurstijden" title="Team voorkeurstijden">
                                    <i class="bi bi-clock-history me-1" aria-hidden="true"></i> <span class="nav-label">Team voorkeurstijden</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (ToonAdmin)
        {
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100 d-flex justify-content-between align-items-center px-0 py-1"
                        @onclick="() => ToggleGroep(GroepAdmin)" @onclick:stopPropagation="true" aria-expanded="@IsOpen(GroepAdmin)">
                    <span><i class="bi bi-shield-check me-1" aria-hidden="true"></i> Admin</span>
                    <i class="bi @(IsOpen(GroepAdmin) ? "bi-chevron-down" : "bi-chevron-right") ms-1 small" aria-hidden="true"></i>
                </button>
                @if (IsOpen(GroepAdmin))
                {
                    <div class="nav-subitems ps-2">
                        @if (Zichtbaar.Mag(MenuKeys.AppInstellingen))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="instellingen" Match="NavLinkMatch.All" title="App instellingen">
                                    <i class="bi bi-sliders me-1" aria-hidden="true"></i> <span class="nav-label">App instellingen</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.SportlinkExtensie))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="sportlink-extension-settings" title="Sportlink Web Extension">
                                    <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> <span class="nav-label">Sportlink Web Extension</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.BegeleidingImport))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="instellingen/teambegeleiding-import" title="Teambegeleiding importeren">
                                    <i class="bi bi-upload me-1" aria-hidden="true"></i> <span class="nav-label">Teambegeleiding importeren</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.EmailTemplates))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="email-templates" title="E-mailtemplates">
                                    <i class="bi bi-file-text me-1" aria-hidden="true"></i> <span class="nav-label">E-mailtemplates</span>
                                </NavLink>
                            </div>
                        }
                        @* "Rechten per rol" heeft bewust geen eigen sleutel: altijd admin-only (anders kan een rol zichzelf rechten geven). *@
                        @if (Auth.IsAdmin)
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="sportlink-rol-instellingen" title="Rechten per rol">
                                    <i class="bi bi-shield-lock me-1" aria-hidden="true"></i> <span class="nav-label">Rechten per rol</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.Teamaliassen))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="teamaliassen" title="Teamaliassen">
                                    <i class="bi bi-tags me-1" aria-hidden="true"></i> <span class="nav-label">Teamaliassen</span>
                                </NavLink>
                            </div>
                        }
                        @if (Zichtbaar.Mag(MenuKeys.Thema))
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link py-1" href="instellingen/thema" title="Club-thema">
                                    <i class="bi bi-palette me-1" aria-hidden="true"></i> <span class="nav-label">Club-thema</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* ── Testmodus-sectie: alleen zichtbaar bij ALLSTARS ── *@
        @if (IsTestmodus)
        {
            <div class="nav-item px-3 mt-2">
                <div class="px-2 mb-1" style="font-size:0.72rem; color:var(--theme-warning); letter-spacing:.05em; font-weight:600;">
                    TESTMODUS
                </div>
                <NavLink class="nav-link nav-link-testmodus py-1" href="testdata/wedstrijden">
                    <i class="bi bi-database-gear me-1" aria-hidden="true"></i> Testdata
                </NavLink>
            </div>
        }

        @if (Auth.IsAuthenticated)
        {
            <div class="nav-item px-3 mt-3">
                <small class="text-light px-2 d-block">Ingelogd als @Auth.UserName@(Auth.IsAdmin ? " (admin)" : "")</small>
                <button class="btn btn-sm btn-outline-light mt-2 ms-2" @onclick="LogoutAsync">Uitloggen</button>
            </div>
        }
    </nav>
</div>
