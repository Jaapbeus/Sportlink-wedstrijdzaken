@inherits LayoutComponentBase
@using System.Reflection
@using BlazorAdmin.Models
@using BlazorAdmin.Services
@inject InstellingenApiClient Api
@inject ClubSelectorService ClubSelector
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center">
            <div class="flex-fill"></div>
            <div class="d-flex justify-content-center align-items-center gap-2">
                @if (_clubs.Count > 1)
                {
                    <select @key="@($"{_clubs.Count}|{ClubSelector.SelectedClubCode}")"
                            class="form-select form-select-sm club-selector @(IsTestmodus ? "club-selector-testmodus" : "")"
                            @onchange="OnClubChanged" value="@ClubSelector.SelectedClubCode">
                        @foreach (var club in _clubs)
                        {
                            <option value="@club.ClubCode">@club.ClubName</option>
                        }
                    </select>
                }
                else if (_backendBezig)
                {
                    <span class="text-muted small d-flex align-items-center gap-1">
                        <span class="spinner-border spinner-border-sm" style="width:.8rem;height:.8rem;" role="status"></span>
                        Backend start op…
                    </span>
                }
            </div>
            <div class="flex-fill d-flex align-items-center justify-content-end gap-2">
                <span class="text-muted small top-row-versie">v@(Assembly.GetExecutingAssembly().GetName().Version?.ToString(4) ?? "?")</span>
                <ThemeModeToggle />
                <FeedbackWidget />
                <a href="https://github.com/Jaapbeus/Sportlink-wedstrijdzaken" target="_blank">About</a>
            </div>
        </div>

        <article class="content px-4">
            @if (_poort.IsVrij)
            {
                @Body
            }
            else
            {
                <div class="text-muted d-flex align-items-center gap-2 py-3" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    Gegevens laden…
                </div>
            }
        </article>
    </main>
</div>
