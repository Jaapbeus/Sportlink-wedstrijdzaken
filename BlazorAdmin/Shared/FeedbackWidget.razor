<button class="btn btn-warning btn-sm me-3" @onclick="OpenAsync">FEEDBACK</button>

@if (_isOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:var(--theme-modal-backdrop)" @onclick="Sluit">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">

                @if (_stap == Stap.Formulier)
                {
                    <div class="modal-header">
                        <h5 class="modal-title">Feedback geven</h5>
                        <button type="button" class="btn-close" @onclick="Sluit"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Wat wil je melden?</label>
                            <div class="btn-group w-100" role="group">
                                @foreach (var optie in FeedbackWidgetState.Types)
                                {
                                    <input type="radio" class="btn-check" id="type-@optie.Waarde"
                                           name="feedbackType" value="@optie.Waarde"
                                           checked="@(_type == optie.Waarde)"
                                           @onchange="() => KiesType(optie.Waarde)" />
                                    <label class="btn btn-outline-secondary" for="type-@optie.Waarde">@optie.Label</label>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Omschrijving</label>
                            <textarea class="form-control" rows="4" placeholder="Beschrijf in eigen woorden wat er mis gaat of wat je wilt kunnen doen…"
                                      @bind="_beschrijving"></textarea>
                        </div>

                        <p class="text-muted small mb-0">@FeedbackWidgetState.PrivacyUitleg(IsAdmin)</p>

                        @if (_vragen.Count > 0)
                        {
                            <div class="alert alert-info py-2 my-3">
                                <small>We hebben nog wat extra informatie nodig:</small>
                            </div>
                            @for (var i = 0; i < _vragen.Count; i++)
                            {
                                var idx = i;
                                <div class="mb-3">
                                    <label class="form-label small">@_vragen[idx]</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(_antwoorden.Count > idx ? _antwoorden[idx] : "")"
                                           @oninput="e => ZetAntwoord(idx, e.Value?.ToString() ?? string.Empty)" />
                                </div>
                            }
                        }

                        @if (_foutmelding != null)
                        {
                            <div class="alert alert-danger py-2 mt-2">@_foutmelding</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="Sluit">Annuleren</button>
                        <button class="btn btn-primary" disabled="@_bezig" @onclick="ControlerenAsync">
                            @if (_bezig)
                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(_vragen.Count > 0 ? "Opnieuw controleren" : "Controleren")
                        </button>
                    </div>
                }

                else if (_stap == Stap.Overzicht)
                {
                    <div class="modal-header">
                        <h5 class="modal-title">Klopt dit zo?</h5>
                        <button type="button" class="btn-close" @onclick="Sluit"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning py-2 small mb-3">@FeedbackWidgetState.PubliciteitWaarschuwing(IsAdmin)</div>
                        <dl class="row mb-0 small">
                            <dt class="col-4">Soort</dt>
                            <dd class="col-8">@FeedbackWidgetState.LabelVoor(_type)</dd>
                            <dt class="col-4">Pagina</dt>
                            <dd class="col-8">@(_context?.Pagina ?? "—")</dd>
                            <dt class="col-4">Versie</dt>
                            <dd class="col-8">@(_context?.Versie ?? "?")</dd>
                        </dl>
                        <hr class="my-2" />
                        <p class="small mb-0"><em>@_beschrijving</em></p>
                        @if (_vragen.Count > 0)
                        {
                            <ul class="list-unstyled mt-2 mb-0 small">
                                @for (var i = 0; i < _vragen.Count; i++)
                                {
                                    <li><strong>@_vragen[i]</strong><br />@(_antwoorden.Count > i ? _antwoorden[i] : "—")</li>
                                }
                            </ul>
                        }

                        <hr class="my-3" />
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="feedback-telemetrie" @bind="_metTelemetrie" />
                            <label class="form-check-label fw-semibold" for="feedback-telemetrie">
                                Technische gegevens meesturen
                            </label>
                            <div class="form-text">
                                Helpt de ontwikkelaar om het probleem terug te vinden. Alleen zichtbaar voor beheerders,
                                nooit in de openbare tekst, en na 90 dagen gewist.
                            </div>
                        </div>
                        <button type="button" class="btn btn-link btn-sm px-0" @onclick="() => _toonContext = !_toonContext">
                            @(_toonContext ? "Verberg" : "Bekijk") wat er wordt meegestuurd
                        </button>
                        @if (_toonContext)
                        {
                            <pre class="border rounded bg-light p-2 small mb-0 feedback-context">@ContextTekst</pre>
                            <p class="text-muted small mb-0 mt-1">
                                Persoonsgegevens (e-mailadressen, ID's, tokens, zoekwaarden in webadressen) zijn hieruit al weggehaald.
                                Er worden geen schermafbeeldingen en geen ingevulde formulierinhoud meegestuurd.
                            </p>
                        }

                        @if (_foutmelding != null)
                        {
                            <div class="alert alert-danger py-2 mt-2">@_foutmelding</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="TerugNaarFormulier">← Terug</button>
                        <button class="btn btn-success" disabled="@_bezig" @onclick="VersturenAsync">
                            @if (_bezig)
                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(IsAdmin ? "Voorbeeld bekijken →" : "Versturen")
                        </button>
                    </div>
                }

                else if (_stap == Stap.Voorbeeld)
                {
                    <div class="modal-header">
                        <h5 class="modal-title">Zo wordt uw melding gepubliceerd</h5>
                        <button type="button" class="btn-close" @onclick="Sluit"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger py-2 mb-3">
                            <strong>⚠️ Dit wordt openbaar op internet gepubliceerd</strong> als GitHub-issue —
                            iedereen kan het lezen, ook zonder account. Controleer hieronder woord voor woord of
                            er geen namen, adressen, geboortedata, lidnummers, wachtwoorden of andere
                            persoonsgegevens in staan.
                        </div>

                        <label class="form-label fw-semibold small mb-1">Titel van het issue</label>
                        <p class="border rounded bg-light p-2 small mb-3">@_voorbeeldTitel</p>

                        <label class="form-label fw-semibold small mb-1">Volledige tekst van het issue</label>
                        <pre class="border rounded bg-light p-2 small mb-2 feedback-voorbeeld">@_voorbeeldBody</pre>
                        <p class="text-muted small mb-0">
                            Alleen het tijdstip in de tabel wordt bij publiceren op het publicatiemoment gezet;
                            de rest is exact de tekst hierboven. Uw naam en de technische gegevens staan er niet in:
                            die worden alleen in het beheeroverzicht bewaard.
                        </p>

                        @if (_foutmelding != null)
                        {
                            <div class="alert alert-danger py-2 mt-2">@_foutmelding</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="TerugNaarFormulier">← Aanpassen</button>
                        <button class="btn btn-danger" disabled="@_bezig" @onclick="PublicerenAsync">
                            @if (_bezig)
                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Openbaar publiceren
                        </button>
                    </div>
                }

                else if (_stap == Stap.Bevestiging)
                {
                    <div class="modal-header border-0">
                        <h5 class="modal-title text-success">Bedankt!</h5>
                        <button type="button" class="btn-close" @onclick="Sluit"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <div class="fs-1 mb-2">✅</div>
                        <p>@FeedbackWidgetState.BevestigingTekst(IsAdmin, _antwoord)</p>
                        @if (!string.IsNullOrWhiteSpace(_antwoord?.Meldingsnummer))
                        {
                            <p class="text-muted small mb-2">Meldingsnummer @_antwoord!.Meldingsnummer — noem dit nummer als je er later naar vraagt.</p>
                        }
                        @if (IsAdmin && !string.IsNullOrWhiteSpace(_antwoord?.IssueUrl))
                        {
                            <a href="@_antwoord!.IssueUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                                Issue #@_antwoord.IssueNummer bekijken
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_antwoord?.Waarschuwing))
                        {
                            <div class="alert alert-warning py-2 small mt-3 mb-0">@_antwoord!.Waarschuwing</div>
                        }
                    </div>
                    <div class="modal-footer border-0">
                        <button class="btn btn-secondary" @onclick="Sluit">Sluiten</button>
                    </div>
                }

            </div>
        </div>
    </div>
}
