        <hr />
        <h5>E-mailantwoorden</h5>
        <p class="text-muted small">Deze instellingen worden per geselecteerde club opgeslagen. Automatische verwerking gebruikt de primaire club en mailbox die voor deze omgeving zijn ingesteld; de e-mailtester gebruikt de geselecteerde club. Zonder afgeronde import of beheerderwijziging blijft verwerking uit en review aan.</p>
        @if (Settings.EmailInstellingenStatus is not null and not "Beschikbaar")
        {
            <div class="alert alert-warning" id="email-instellingen-status" role="status">
                E-mailinstellingen zijn nog niet actief (@Settings.EmailInstellingenStatus). Verwerking staat veilig uit.
            </div>
        }
        <div class="row">
            <div class="col-md-8 mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="email-verwerking-ingeschakeld"
                           @bind="Settings.EmailVerwerkingIngeschakeld" />
                    <label class="form-check-label" for="email-verwerking-ingeschakeld">Inkomende e-mail automatisch verwerken</label>
                </div>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="email-review-modus"
                           @bind="Settings.EmailReviewModusActief" />
                    <label class="form-check-label" for="email-review-modus">Antwoorden eerst laten beoordelen</label>
                </div>
                <label class="form-label mt-2" for="email-review-ontvanger">Review-ontvanger (optioneel)</label>
                <input class="form-control" type="email" id="email-review-ontvanger"
                       @bind="Settings.EmailReviewOntvanger" autocomplete="off" />
                <small class="form-text text-muted">Eén e-mailadres zonder naam. Leeg betekent dat voorstellen alleen in het e-maillog staan.</small>
                @if (ToonBevestiging)
                {
                    <div class="alert alert-warning mt-3" id="email-review-bevestiging" role="alertdialog">
                        <p>Reviewmodus uitschakelen kan automatische antwoorden direct naar afzenders sturen. Bevestig deze wijziging voor deze club.</p>
                        <button type="button" class="btn btn-danger btn-sm" id="email-review-bevestig"
                                @onclick="Bevestig">Ja, reviewmodus uitschakelen</button>
                        <button type="button" class="btn btn-link btn-sm" id="email-review-annuleer"
                                @onclick="Annuleer">Annuleren</button>
                    </div>
                }
            </div>
        </div>
