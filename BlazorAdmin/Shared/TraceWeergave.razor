@* Beslissingstrace van een verwerkt bericht (#1568): gedeeld door de e-mailtester en het e-maillog.
   Voor beheerders staan bij een niet-herkend team en bij de classificatie leeracties (#1568 deel C). *@
@using BlazorAdmin.Services
@if (Trace is { Stappen.Count: > 0 })
{
    <div class="@ZekerheidAlertKlasse" role="status">
        <strong>@ZekerheidSamenvatting</strong>
        @if (Trace.Oordeel?.Redenen.Count > 0)
        {
            <ul class="mb-0 mt-1">
                @foreach (var reden in Trace.Oordeel.Redenen)
                {
                    <li>@reden</li>
                }
            </ul>
        }
    </div>
    <ol class="list-group list-group-numbered">
        @foreach (var stap in Trace.Stappen)
        {
            <li class="@StapKlasse(stap)">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">@stap.Titel <span class="badge @ZekerheidBadgeKlasse(stap)">@stap.Zekerheid</span></div>
                    @stap.Uitkomst
                    @if (stap.Details.Count > 0)
                    {
                        <div class="small text-muted">@StapDetails(stap)</div>
                    }
                    @if (KanCorrigeren)
                    {
                        @if (TraceActies.KoppelTekst(stap) is { } koppelTekst)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary mt-1"
                                    @onclick="() => WisselActie(stap, koppelTekst)">
                                Koppel '@koppelTekst' aan team…
                            </button>
                            @if (_openStap == stap && _openActie == Actie.Koppel)
                            {
                                <TeamKoppelFormulier RuweTekst="@koppelTekst" TekstVergrendeld="false"
                                                     HerkomstVerwerkingId="VerwerkingId"
                                                     OnGekoppeld="GekoppeldAsync" OnAnnuleer="Sluit" />
                            }
                        }
                        @if (TraceActies.ClassificatieType(stap) is { } classificatieType)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary mt-1"
                                    @onclick="() => WisselActie(stap, classificatieType)">
                                Verzoektype corrigeren…
                            </button>
                            @if (_openStap == stap && _openActie == Actie.Corrigeer)
                            {
                                <LeermomentFormulier OrigineelType="@classificatieType" SuggestieSamenvatting="@SuggestieSamenvatting"
                                                     HerkomstVerwerkingId="VerwerkingId"
                                                     OnOpgeslagen="GeleerdAsync" OnAnnuleer="Sluit" />
                            }
                        }
                    }
                    @if (!string.IsNullOrEmpty(_melding) && _openStap == stap)
                    {
                        <div class="alert alert-success mt-2 mb-0">@_melding</div>
                    }
                </div>
            </li>
        }
    </ol>
}
