@* Koppelt een teamtekst aan een team door een alias aan te maken (#1568 deel C). Gedeeld door de trace,
   de wachtrij met onbekende teamteksten en het scherm Teamaliassen. De alias is direct goedgekeurd. *@
<div class="card card-body mt-2">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="@_tekstId">Teamtekst</label>
            <input id="@_tekstId" class="form-control" maxlength="200" @bind="_tekst" @bind:event="oninput"
                   readonly="@TekstVergrendeld" />
        </div>
        <div class="col-md-5">
            <label class="form-label" for="@_teamId">Hoort bij team</label>
            <select id="@_teamId" class="form-select" @bind="_gekozenTeamId">
                <option value="0">Kies een team…</option>
                @foreach (var team in _teams)
                {
                    <option value="@team.TeamId">@team.Teamnaam</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="button" class="btn btn-primary" disabled="@(!KanOpslaan)" @onclick="() => OpslaanAsync(false)">
                @(_bezig ? "Bezig..." : "Koppel")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="AnnuleerAsync">Annuleer</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_teamsFout))
    {
        <div class="alert alert-warning mt-2 mb-0">@_teamsFout</div>
    }
    @if (!string.IsNullOrEmpty(_conflict))
    {
        <div class="alert alert-warning mt-2 mb-0">
            @_conflict
            <button type="button" class="btn btn-sm btn-warning ms-2" disabled="@(!KanOpslaan)" @onclick="() => OpslaanAsync(true)">
                Herkoppel naar dit team
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_dubbelzinnig))
    {
        <div class="alert alert-warning mt-2 mb-0">
            <strong>Let op, deze schrijfwijze is dubbelzinnig.</strong> @_dubbelzinnig
            <button type="button" class="btn btn-sm btn-warning ms-2" disabled="@(!KanOpslaan)" @onclick="() => OpslaanAsync(false, true)">
                Ja, alle mails met deze schrijfwijze naar dit team
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_fout))
    {
        <div class="alert alert-danger mt-2 mb-0">@_fout</div>
    }
</div>
