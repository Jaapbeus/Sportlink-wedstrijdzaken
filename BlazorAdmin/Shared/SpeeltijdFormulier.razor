@using BlazorAdmin.Models

<h5 class="mt-1">@(IsNew ? "Nieuwe leeftijdscategorie" : $"Bewerken: {Model.Leeftijd}")</h5>
<p class="text-muted small">
    WedstrijdTotaal = speeltijd + rust. Voorbeeld senioren: 2×45 + 15 rust + 10 buffer = 115.<br />
    <strong>Standaard voorkeurstijd</strong> geldt voor teams in deze categorie die géén eigen
    voorkeurstijd hebben onder Instellingen → Voorkeurstijden. Laat leeg om geen streeftijd te
    gebruiken; de planner kiest dan het eerst beschikbare tijdslot.
</p>
<EditForm Model="Model" OnValidSubmit="OnOpslaan">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Leeftijd</label>
            <input class="form-control" @bind="Model.Leeftijd" disabled="@(!IsNew)" placeholder="JO12" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Veldafmeting</label>
            <input class="form-control" type="number" step="0.25" min="0.25" max="1.00"
                   @bind="Model.Veldafmeting" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Totaal (min) <small class="text-muted">incl. rust</small></label>
            <input class="form-control" type="number" min="1" @bind="Model.WedstrijdTotaal" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Helft (min)</label>
            <input class="form-control" type="number" min="1" @bind="Model.WedstrijdHelft" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Rust (min)</label>
            <input class="form-control" type="number" min="0" @bind="Model.WedstrijdRust" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Standaard voorkeurstijd</label>
            <TimeInput Value="@Model.StandaardVoorkeurTijd"
                       ValueChanged="ZetVoorkeurTijd"
                       Placeholder="bijv. 10:00" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary" @onclick="OnAnnuleer">Annuleer</button>
        </div>
    </div>
</EditForm>
@if (SaveError != null)
{
    <div class="alert alert-danger mt-2">@SaveError</div>
}
