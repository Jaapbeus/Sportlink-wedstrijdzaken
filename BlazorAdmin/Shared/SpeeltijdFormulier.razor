@using BlazorAdmin.Models

<h5 class="mt-1 speeltijd-formulier-kop">@(Sessie.IsNieuw ? "Nieuwe leeftijdscategorie" : $"Bewerken: {Sessie.Model.Leeftijd}")</h5>
<p class="text-muted small">
    WedstrijdTotaal = speeltijd + rust. Voorbeeld senioren: 2×45 + 15 rust + 10 buffer = 115.<br />
    <strong>Standaard voorkeurstijd</strong> geldt voor teams in deze categorie die géén eigen
    voorkeurstijd hebben onder Instellingen → Voorkeurstijden. Laat leeg om geen streeftijd te
    gebruiken; de planner kiest dan het eerst beschikbare tijdslot.
</p>
@* Labels zijn via for/id aan hun veld gekoppeld (#1554); de ids zijn uniek per formulier. *@
<EditForm Model="Sessie.Model" OnValidSubmit="OnOpslaan">
    <div class="speeltijd-formulier-velden">
        <div>
            <label class="form-label" for="@Id("leeftijd")">Leeftijd</label>
            <input id="@Id("leeftijd")" class="form-control" @bind="Sessie.Model.Leeftijd" disabled="@(!Sessie.IsNieuw)" placeholder="JO12" />
        </div>
        <div>
            <label class="form-label" for="@Id("veldafmeting")">Veldafmeting</label>
            <input id="@Id("veldafmeting")" class="form-control" type="number" step="0.25" min="0.25" max="1.00"
                   @bind="Sessie.Model.Veldafmeting" />
        </div>
        <div>
            <label class="form-label" for="@Id("totaal")">Totaal (min) <small class="text-muted">incl. rust</small></label>
            <input id="@Id("totaal")" class="form-control" type="number" min="1" @bind="Sessie.Model.WedstrijdTotaal" />
        </div>
        <div>
            <label class="form-label" for="@Id("helft")">Helft (min)</label>
            <input id="@Id("helft")" class="form-control" type="number" min="1" @bind="Sessie.Model.WedstrijdHelft" />
        </div>
        <div>
            <label class="form-label" for="@Id("rust")">Rust (min)</label>
            <input id="@Id("rust")" class="form-control" type="number" min="0" @bind="Sessie.Model.WedstrijdRust" />
        </div>
        <div>
            <label class="form-label" for="@Id("voorkeurstijd")">Standaard voorkeurstijd</label>
            <TimeInput id="@Id("voorkeurstijd")"
                       Value="@Sessie.Model.StandaardVoorkeurTijd"
                       ValueChanged="ZetVoorkeurTijd"
                       Placeholder="bijv. 10:00" />
        </div>
        <div class="speeltijd-formulier-knoppen">
            <button type="submit" class="btn btn-primary" disabled="@Sessie.Bezig">@(Sessie.Bezig ? "Opslaan…" : "Opslaan")</button>
            <button type="button" class="btn btn-secondary" @onclick="OnAnnuleer">Annuleer</button>
        </div>
    </div>
</EditForm>
@if (Sessie.Fout != null)
{
    <div class="alert alert-danger mt-2" role="alert">@Sessie.Fout</div>
}
