@* Sportlink-paneel voor één wedstrijd in Dagplanning (#991/#992/#993/#994/#995), sinds #1122 een
   eigen component met code-behind: één instantie per uitgeklapte rij, dus gewone velden i.p.v.
   dictionaries per wedstrijdcode. Alle logica staat in SportlinkMatchPanel.razor.cs. *@

@if (!string.IsNullOrEmpty(_laadFout))
{
    <span class="text-danger">@_laadFout</span>
}
else if (_info == null)
{
    <span class="text-muted">Bezig met laden…</span>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        <div><strong>PublicMatchId:</strong> @(_info.PublicMatchId ?? "—")</div>
        <div><strong>Status:</strong> @(_info.MatchStatus ?? "—")</div>
        @if (_info.IsCanceledMatch) { <span class="badge bg-danger">Geannuleerd</span> }
        @if (_info.IsConceptMatch) { <span class="badge bg-warning text-dark">Concept</span> }
    </div>
    <div class="d-flex flex-wrap gap-2 mt-1">
        @if (_info.IsEditFieldAllowed) { <span class="badge bg-light text-dark border">Veld wijzigen toegestaan</span> }
        @if (_info.IsAssignDressingRoomsAllowed) { <span class="badge bg-light text-dark border">Kleedkamers toewijzen toegestaan</span> }
        @if (_info.IsAssignOfficialsAllowed) { <span class="badge bg-light text-dark border">Scheidsrechters toewijzen toegestaan</span> }
        @if (_info.IsAddScoreAllowed) { <span class="badge bg-light text-dark border">Uitslag invoeren toegestaan</span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(_info.TaskStatus))
    {
        <div class="mt-1 text-muted">Openstaand: @_info.TaskStatus</div>
    }

    @if (_info.IsAssignDressingRoomsAllowed && !_info.KleedkamersFeatureToegestaan)
    {
        <div class="text-muted small">Kleedkamers toewijzen staat uit voor jouw rol bij deze club.</div>
    }
    @if (_info.IsAssignDressingRoomsAllowed && _info.KleedkamersFeatureToegestaan)
    {
        @* #992: eerste echte Sportlink-mutatie — de server valideert IsAssignDressingRoomsAllowed
           én de #1341-rol-instelling opnieuw (SportlinkMutationGuard resp. RolFeatureInstellingenRepository). *@
        <div class="mt-2 d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label mb-0 small">Thuis</label>
                <input class="form-control form-control-sm" style="width:6rem;" @bind="_kleedkamerThuis" />
            </div>
            <div>
                <label class="form-label mb-0 small">Uit</label>
                <input class="form-control form-control-sm" style="width:6rem;" @bind="_kleedkamerUit" />
            </div>
            <div>
                <label class="form-label mb-0 small">Official</label>
                <input class="form-control form-control-sm" style="width:6rem;" @bind="_kleedkamerOfficial" />
            </div>
            <button class="btn btn-sm btn-outline-primary" disabled="@_kleedkamers.Bezig" @onclick="SaveDressingRoomsAsync">Kleedkamers toewijzen</button>
            @if (_kleedkamers.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
        </div>
        <Melding Status="_kleedkamers" />
    }

    @if (_info.IsEditFieldAllowed && !_info.VeldFeatureToegestaan)
    {
        <div class="text-muted small">Veld wijzigen staat uit voor jouw rol bij deze club.</div>
    }
    @if (_info.IsEditFieldAllowed && _info.VeldFeatureToegestaan)
    {
        @* #993: IsForceUpdate blijft server-side hard false (semantiek niet bevestigd) — geen UI-optie.
           #1339: FieldId/FieldSize staan voorafgevuld met de huidige waarde (indien bekend). De
           dropdowns hieronder vullen ze met een VOORSTEL op basis van onze eigen veldnaam — de
           tekstvelden blijven de bron van waarheid en zijn altijd handmatig te overschrijven. *@
        @if (_info.VeldOpties is { Count: > 0 })
        {
            <div class="mt-2 d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-0 small">Veld (voorstel)</label>
                    <select class="form-select form-select-sm" style="width:10rem;"
                            value="@_veldGekozenVeldNummer" @onchange="OnVeldGekozen">
                        <option value="">— kies veld —</option>
                        @foreach (var optie in _info.VeldOpties)
                        {
                            <option value="@optie.VeldNummer">@optie.VeldNaam</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0 small">Subpositie</label>
                    <select class="form-select form-select-sm" style="width:8rem;"
                            value="@_veldGekozenSubpositie" @onchange="OnSubpositieGekozen">
                        @foreach (var optie in _info.SubpositieOpties ?? new())
                        {
                            <option value="@optie.Subpositie">@(optie.Subpositie ?? "heel veld")</option>
                        }
                    </select>
                </div>
            </div>
        }
        <div class="mt-2 d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label mb-0 small">FieldId</label>
                <input class="form-control form-control-sm" style="width:10rem;" @bind="_veldFieldId" />
            </div>
            <div>
                <label class="form-label mb-0 small">FieldSize</label>
                <input class="form-control form-control-sm" style="width:6rem;" @bind="_veldFieldSize" />
            </div>
            <button class="btn btn-sm btn-outline-primary" disabled="@_veld.Bezig" @onclick="SaveFieldAsync">Veld wijzigen</button>
            @if (_veld.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
        </div>
        <Melding Status="_veld" />
    }

    @if (_info.IsAssignOfficialsAllowed && !_info.ScheidsrechterFeatureToegestaan)
    {
        <div class="text-muted small">Scheidsrechters toewijzen staat uit voor jouw rol bij deze club.</div>
    }
    @if (_info.IsAssignOfficialsAllowed && _info.ScheidsrechterFeatureToegestaan)
    {
        @* #994: scaffolding, altijd code-gelockt (forceDryRun). Bewust geen zoekfunctie (AVG):
           alleen een relatiecode/persoons-ID per positie, geen namen. *@
        <div class="mt-2 d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label mb-0 small">Scheidsrechter (relatiecode)</label>
                <input class="form-control form-control-sm" style="width:8rem;" @bind="_officialScheidsrechter" />
            </div>
            <div>
                <label class="form-label mb-0 small">AR1 (relatiecode)</label>
                <input class="form-control form-control-sm" style="width:8rem;" @bind="_officialAr1" />
            </div>
            <div>
                <label class="form-label mb-0 small">AR2 (relatiecode)</label>
                <input class="form-control form-control-sm" style="width:8rem;" @bind="_officialAr2" />
            </div>
            <button class="btn btn-sm btn-outline-primary" disabled="@_officials.Bezig" @onclick="SaveOfficialsAsync">Scheidsrechters toewijzen</button>
            @if (_officials.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
        </div>
        <div class="text-muted small">@SportlinkActieStatus.CodeLockTekst</div>
        <Melding Status="_officials" />
    }

    @if (_info.IsHomeMatch)
    {
        @* #995/#1320: wijzigingsverzoek datum/tijd/accommodatie — ALLEEN stap 1 (valideren),
           ONBEVESTIGD en altijd code-gelockt: de enige mutatie die een ECHTE tegenstander raakt.
           Bewust GEEN bevestigknop — dat zou een stap 2 suggereren die niet gebouwd is. *@
        <div class="mt-2 pt-2 border-top">
            <div class="fw-semibold small">Wijzigingsverzoek datum/tijd/accommodatie</div>
            <div class="text-muted small">
                Wijzigen van datum, tijd of accommodatie vereist goedkeuring door de tegenstander.
                Dit valideert alleen (stap 1) — er is bewust geen bevestigstap gebouwd.
            </div>
            <div class="mt-2 d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-0 small">Nieuwe datum</label>
                    @* type="date" met een string-veld: Blazor's @bind verwacht daar DateTime — expliciet binden. *@
                    <input class="form-control form-control-sm" style="width:9rem;" type="date"
                           value="@_wijzigingDatum" @onchange="e => _wijzigingDatum = e.Value?.ToString()" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Nieuwe starttijd</label>
                    <TimeInput @bind-Value="_wijzigingTijd" Class="form-control-sm" />
                </div>
                <div>
                    <label class="form-label mb-0 small">FacilityId</label>
                    <input class="form-control form-control-sm" style="width:10rem;" @bind="_wijzigingFacilityId" />
                </div>
            </div>
            <div class="mt-2">
                <label class="form-label mb-0 small">Toelichting (verplicht)</label>
                <input class="form-control form-control-sm" @bind="_wijzigingToelichting" />
            </div>

            @if (!_wijzigingBevestigingGevraagd)
            {
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-primary" disabled="@_wijziging.Bezig" @onclick="VraagBevestigingWijziging">Wijzigingsverzoek valideren</button>
                    @if (_wijziging.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
                </div>
            }
            else
            {
                @* #1320: de "afzonderlijke handmatige startactie" — pas déze knop verstuurt de
                   echte PUT. Waarschuwing herhaalt bewust dat zelfs deze validatiestap Sportlinks
                   eigen verzendmoment kan zijn (zie docs/SPORTLINK-WEB-EXTENSION.md §4.4/§6.4). *@
                <div class="alert alert-warning py-2 px-2 mt-2 mb-0 small">
                    Let op: dit is een echte aanroep naar Sportlink Club. Ook al is dit bedoeld als
                    "alleen valideren" (stap 1), Sportlink kan hierbij al direct een
                    wijzigingsverzoek naar de tegenstander versturen. Weet je dat zeker?
                    <div class="mt-2 d-flex gap-2">
                        <button class="btn btn-sm btn-danger" disabled="@_wijziging.Bezig" @onclick="SaveMatchChangeRequestAsync">
                            Ja, verstuur de validatie-PUT naar Sportlink
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" disabled="@_wijziging.Bezig" @onclick="AnnuleerBevestigingWijziging">Annuleren</button>
                        @if (_wijziging.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
                    </div>
                </div>
            }

            <div class="text-muted small">@SportlinkActieStatus.CodeLockTekst</div>
            <Melding Status="_wijziging" />

            @if (_wijzigingTrace is not null)
            {
                @* #1320: diagnostiekpaneel — nerdy, controleerbare request/response-trace. Bewust
                   alleen de al gedistilleerde velden (nooit de ruwe body): tokens, cookies en
                   autorisatieheaders komen hier nooit in terecht. *@
                <div class="mt-2 p-2 border rounded small" style="font-family: monospace;">
                    <div><strong>Stap 1: valideren</strong> — @_wijzigingTrace.TijdstipUtc.ToString("u")</div>
                    <div>@_wijzigingTrace.HttpMethode @_wijzigingTrace.Endpoint → HTTP @_wijzigingTrace.HttpStatusCode</div>
                    @if (_wijzigingTrace.Resultaat?.Validatie is { } validatie)
                    {
                        <div>
                            IsSuccess=@Weergeef(validatie.IsSuccess)
                            · IsMatchChangeRequestMandatory=@Weergeef(validatie.IsMatchChangeRequestMandatory)
                            · IsOwnFacility=@Weergeef(validatie.IsOwnFacility)
                            · IsForceUpdate=@Weergeef(validatie.IsForceUpdate)
                        </div>
                        <div>ConfirmationNeeded=@validatie.ConfirmationNeeded · HasBlockingMessages=@validatie.HasBlockingMessages</div>
                    }
                    <div class="text-muted mt-1">
                        Stap 2 (bevestigen) bestaat in deze app bewust niet — zie #1320/#995: de
                        werkelijke bevestigingsvorm voor een verplicht wijzigingsverzoek is nooit met
                        een netwerktrace gezien.
                    </div>
                </div>

                @if (_wijzigingTrace.AuditId is { } auditId)
                {
                    <div class="mt-2">
                        <label class="form-label mb-0 small">Testnotitie bij deze poging (audit #@auditId)</label>
                        <div class="d-flex gap-2">
                            <input class="form-control form-control-sm" @bind="_wijzigingNotitie"
                                   placeholder="Bijv. wat je in Sportlink Club zelf zag" />
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_wijzigingNotitieStatus.Bezig" @onclick="SlaWijzigingNotitieOpAsync">Notitie opslaan</button>
                            @if (_wijzigingNotitieStatus.Bezig) { <span class="spinner-border spinner-border-sm"></span> }
                        </div>
                        <Melding Status="_wijzigingNotitieStatus" />
                    </div>
                }
            }

            @if (_wijzigingValidatieMeldingen is { Count: > 0 })
            {
                <ul class="mt-1 mb-0 small">
                    @foreach (var melding in _wijzigingValidatieMeldingen) { <li>@melding</li> }
                </ul>
            }
        </div>
    }
}
