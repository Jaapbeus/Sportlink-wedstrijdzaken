@using BlazorAdmin.Models
@* CSS-pad van één themakleur (#1442): de variabele, de -light/-dark-variant die theme.js zet, en de
   selectors die hem gebruiken — live uit de geladen stylesheets (theme-css-pad.js). Voor wie wil
   zien welke elementen wél en níet in het thema zitten. *@
<details class="thema-css-pad small">
    <summary>
        <code>@Kleur.CssVariabele</code>
        <span class="text-muted">· @(Geladen ? $"{Selectors.Length} selector{(Selectors.Length == 1 ? "" : "s")}" : "…")</span>
    </summary>
    <div class="text-muted">
        Ingesteld via <code>@(Kleur.CssVariabele)-light</code> / <code>@(Kleur.CssVariabele)-dark</code>
        (sleutel <code>@Kleur.Sleutel</code>)
    </div>
    @if (Selectors.Length > 0)
    {
        <ul class="mb-0 ps-3">
            @foreach (var selector in Selectors)
            {
                <li><code>@selector</code></li>
            }
        </ul>
    }
    else if (Geladen)
    {
        <div class="text-muted fst-italic">Geen CSS-regel gevonden — de kleur wordt inline vanuit code gezet, of nergens gebruikt.</div>
    }
</details>

@code {
    [Parameter, EditorRequired] public ThemeKleurDefinitie Kleur { get; set; } = default!;
    [Parameter] public string[] Selectors { get; set; } = Array.Empty<string>();
    /// <summary><c>false</c> zolang theme-css-pad.js nog niet heeft geantwoord.</summary>
    [Parameter] public bool Geladen { get; set; }
}
