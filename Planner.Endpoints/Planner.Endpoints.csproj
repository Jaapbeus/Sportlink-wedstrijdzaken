<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1271: endpoint-orkestratie (routeparameter/DI/IActionResult) leunt op ASP.NET Core en de
         Azure Functions Worker — die afhankelijkheid blijft bewust buiten Planner.Shared (zelfde
         grens als ThemeCore #1248, FeedbackCore #1130). Dit project is de plek waar dat wél mag.
         Geen FrameworkReference/PackageReference-versies hier: Central Package Management via
         Directory.Packages.props (#1129). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planner.Shared\Planner.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Planner.Endpoints.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
