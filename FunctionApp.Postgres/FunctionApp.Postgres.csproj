<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net9.0 is verplicht zolang deze app op een Linux Consumption Plan draait: dat plan
         ondersteunt maximaal .NET 9 (zie CLAUDE.md ".NET versie" — #162, sessie 2026-05-24).
         Niet verhogen vóór de cutover naar Flex Consumption uit epic #1063 — een net10.0-deploy
         naar Linux Consumption geeft 503 "Function host is not running". -->
    <TargetFramework>net9.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FunctionApp.Postgres</RootNamespace>
    <Platforms>AnyCPU;x86</Platforms>
    <DockerFastModeProjectMountDirectory>/home/site/wwwroot</DockerFastModeProjectMountDirectory>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Version>3.5.0.0</Version>
    <AssemblyVersion>3.5.0.0</AssemblyVersion>
    <FileVersion>3.5.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-project heeft toegang tot internal members — zelfde patroon als de SQL Server-tier
         (#476). Nodig omdat vrijwel alles in dit project bewust internal is: het is een
         Functions-host, geen bibliotheek. Vóór issue 890 werd elke verificatie op deze tier gedaan
         met een wegwerp-consoleproject plus een tijdelijk InternalsVisibleTo dat daarna weer werd
         verwijderd — reproduceerbaar op het moment zelf, maar niet bewaakt tegen regressie. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FunctionApp.Postgres.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- #863-precedent: tier-herkomst voor /api/health als build-time metadata, nooit een
         runtime-gok. "Postgres" is de canonieke tier-naam uit scripts/ci/database-tiers.json
         (#816/#865) — nooit een los, eigen naamschema hier. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabaseTier</_Parameter1>
      <_Parameter2>Postgres</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabaseProvider</_Parameter1>
      <_Parameter2>Npgsql</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- #972: INoodmailThrottleStore-port — zelfde versie als de SQL Server-tier, tegen de
         bestaande AzureWebJobsStorage-opslagaccount, geen nieuwe Azure-resource. -->
    <PackageReference Include="Azure.Data.Tables" />
    <!-- #1138: durable sync-job — zelfde AzureWebJobsStorage-opslagaccount, geen nieuwe resource. -->
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Cronos" />
    <!-- §43: uitsluitend voor het uitgaande e-mailpad van AdminTeambegeleidingDoorsturen.
         Zelfde versie als de SQL Server-tier (centraal beheerd, zie Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <!-- #966: uitsluitend voor FeedbackFunction (IChatClient — provider-agnostisch,
         CLAUDE.md-architectuurregel). Zelfde versies als de SQL Server-tier (centraal beheerd). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- #1096: CA-certificaat van de databaseprovider (Supabase) voor sslmode=verify-full.
         Publiek certificaat, geen secret — mag in git en in het deploy-pakket. Ontbreekt dit
         bestand (nog niet toegevoegd, of lokale ontwikkeling), dan is dit een no-op: geen
         build- of publish-fout, alleen geen gekopieerd bestand. Zie docs/ARCHITECTUUR-DATABASE-TIERS.md §50. -->
    <None Update="prod-ca-2021.crt" Condition="Exists('prod-ca-2021.crt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- #561/#1141: KNVB-speeldagenkalender-PDF's — reizen mee in het deploymentpakket, geen
         nieuwe Azure-resource. Verwijst naar dezelfde bestanden als
         FunctionApp/fa-dev-sportlink-01.csproj (Include buiten deze projectmap, Link zet ze op de
         verwachte relatieve plek in de output) in plaats van een tweede 1,3 MB-kopie in git te
         zetten — één bronbestand per regio/seizoen, twee build-outputs. -->
    <Content Include="../FunctionApp/Content/KnvbKalenders/2026-2027/*.pdf" Link="Content/KnvbKalenders/2026-2027/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- #818: PostgresIdentifier/schema-generatie-bouwstenen — dit project bouwt de applicatie-
         datalaag (#860 t/m #887-890) bovenop wat #818 al levert, geen tweede implementatie ervan. -->
    <ProjectReference Include="..\Database.Postgres\Database.Postgres.csproj" />
    <!-- #888: directe referentie i.p.v. alleen transitief via Database.Postgres — nodig zodra
         planner-code hier de gedeelde scheduling-engine (FieldScheduler) en de tier-agnostische
         domeinmodellen uit Planner.Shared aanroept, niet alleen VeldResolver/VeldNormalisatie/
         TeamNaamNormalisatie die al transitief binnenkwamen. Een impliciete afhankelijkheid keert
         de bedoelde gelaagdheid om zodra er planner-logica in Planner.Shared bijkomt. -->
    <ProjectReference Include="..\Planner.Shared\Planner.Shared.csproj" />
  </ItemGroup>
</Project>
