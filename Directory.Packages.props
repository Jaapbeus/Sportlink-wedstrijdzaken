<Project>
  <!--
    NuGet Central Package Management (#1129, finding 4 of de Codex-review #1107).

    Eén versiedefinitie per pakket voor alle .csproj-projecten in deze repository (behalve
    Database/SportlinkSqlDb.sqlproj — dat is geen PackageReference-project en wordt door CPM niet
    aangeraakt, zie docs/DEVELOPER-SETUP.md §8.1). Vóór deze wijziging bepaalde elk project zijn
    eigen pakketversie; Dependabot bumpte alleen /FunctionApp en /BlazorAdmin (.github/dependabot.yml),
    waardoor FunctionApp.Postgres en de testprojecten uit de pas liepen — precies de reden dat
    Microsoft.Extensions.AI.OpenAI 10.9.0 (FunctionApp.Postgres) en OpenAI 2.13.0 een NU1608 gaven:
    10.9.0 declareert `OpenAI [2.12.0, 2.13.0)`, dus 2.13.0 valt er net buiten. 10.10.0 declareert
    exact 2.13.0 en lost dit op zonder onderdrukking.

    Nieuw pakket toevoegen of bestaande versie bumpen: wijzig de <PackageVersion> hier, niet in het
    individuele .csproj-bestand. Zie docs/DEVELOPER-SETUP.md §8.1.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Functions (beide tiers) -->
    <PackageVersion Include="Azure.Data.Tables" Version="12.12.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.5" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.27.1" />

    <!-- Database-clients -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- AI-adapter/provider — #1129: 10.10.0 vereist exact OpenAI 2.13.0, geen NU1608 meer -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />

    <!-- Overig gedeeld -->
    <PackageVersion Include="Microsoft.Graph" Version="6.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- BlazorAdmin (WASM + MSAL) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.12" />

    <!-- Hulpmiddelen buiten de tier-implementatiebomen (MigrationTools/, Tools/) -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />

    <!-- Testprojecten -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      AwesomeAssertions, niet FluentAssertions (#1170). FluentAssertions 8 is overgegaan van
      Apache-2.0 naar de Xceed Community License, die uitsluitend niet-commercieel gebruik
      toestaat en expliciet gebruik uitsluit "by or for an organisation ... that charges fees or
      earns revenues, with or without the intention to make profit". Een vereniging die contributie
      int valt daar pleitbaar onder, en deze repository is publiek en bedoeld om te forken: de
      licentiekeuze geldt dan voor elke club die dat doet. AwesomeAssertions is de Apache-2.0
      community-fork met dezelfde assertie-API; alleen de naamruimte verschilt, dus in de
      testprojecten staat `using AwesomeAssertions;` in plaats van `using FluentAssertions;`.
      Zie CHANGELOG bij deze versie.
    -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>
